+static bool pagani_kbtrace_signposts;   /* pagani-kbtrace=3: also UIKit's signpost subclass 0x2b87 (every frame of every UIKit app) */
+static struct pagani_kbt pagani_kbt;
+static uint32_t pagani_kbt_pending;
+static uint32_t pagani_kbt_call_state;  /* 0 not set up, 1 being set up, 2 ready: set up at the first point, after thread calls */
+/* Allocated at the first point: thread_call_data_t and thread_call_setup are MACH_KERNEL_PRIVATE, out of reach of bsd/. */
+static thread_call_t pagani_kbt_call;
+static LCK_SPIN_DECLARE(pagani_kbt_lock, &kdebug_lck_grp);
+static void pagani_kbtrace_note(struct proc *p, uint32_t code, uint64_t arg1);
+static void pagani_kbtrace_flush(thread_call_param_t p0, thread_call_param_t p1);
 
