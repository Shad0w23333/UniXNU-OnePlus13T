diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index 4d208553..6d92eb35 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -1,3 +1,23 @@
+/*
+ * Image layout: [ BootShim | FD (FD_SIZE) | embedded payload (EMBEDDED_PAYLOAD_SIZE) ]
+ *
+ * The shim copies the FD to FD_BASE and enters it. x0 (the device tree a
+ * Linux-style boot loader passes) is left untouched. With an embedded payload
+ * the shim also hands over where it was loaded:
+ *
+ *   x1 = physical address of the payload (directly after the loaded FD)
+ *   x2 = payload size in bytes
+ *   x3 = EMBEDDED_PAYLOAD_MAGIC ("UNXPAYLD")
+ *
+ * Without one, x1..x3 are zero, so SEC can tell the cases apart.
+ */
+
+#ifndef EMBEDDED_PAYLOAD_SIZE
+#define EMBEDDED_PAYLOAD_SIZE 0
+#endif
+
+#define EMBEDDED_PAYLOAD_MAGIC 0x444C594150584E55
+
 _Head:
   adr   x1, _Payload    /* Set _Entry address */
   b     _Start          /* Jump to the real code */
@@ -7,7 +27,7 @@ _StackBase:
   .quad FD_BASE         /* Text Offset */
 
 _StackSize:
-  .quad FD_SIZE         /* Image Size */
+  .quad FD_SIZE + (_Payload - _Head) + EMBEDDED_PAYLOAD_SIZE /* Complete shim, FD and payload */
   .quad 0               /* Flags */
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
@@ -17,6 +37,17 @@ _StackSize:
 #endif
 
 _Start:
+#if EMBEDDED_PAYLOAD_SIZE > 0
+  /* The payload stays where the boot loader put it, right after the FD. */
+  ldr   x11, =FD_SIZE
+  add   x11, x1, x11
+  ldr   x12, =EMBEDDED_PAYLOAD_SIZE
+  ldr   x13, =EMBEDDED_PAYLOAD_MAGIC
+#else
+  mov   x11, xzr
+  mov   x12, xzr
+  mov   x13, xzr
+#endif
   mov   x4, x1
   ldr   x5, =FD_BASE
   cmp   x4, x5
@@ -31,12 +62,38 @@ _CopyLoop:
   ldr   x5, =FD_BASE
 
 _Entry:
+  /* Publish the copied instructions before executing them. */
+  dsb   sy
+  mrs   x9, ctr_el0
+  ubfx  x9, x9, #16, #4
+  mov   x10, #4
+  lsl   x9, x10, x9
+  sub   x10, x9, #1
+  bic   x8, x5, x10
+  ldr   x7, =FD_SIZE
+  add   x7, x5, x7
+
+_CleanLoop:
+  dc    cvac, x8
+  add   x8, x8, x9
+  cmp   x8, x7
+  b.lo  _CleanLoop
+  dsb   sy
+  ic    iallu
+  dsb   sy
+  isb
+
+  /* Payload handoff for SEC */
+  mov   x1, x11
+  mov   x2, x12
+  mov   x3, x13
   br    x5
 
 _Dead:
   b     _Dead
 
 .text
+.ltorg
 .align 4
 
 _Payload:
