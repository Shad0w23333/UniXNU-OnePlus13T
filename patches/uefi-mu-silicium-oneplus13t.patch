diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index 0c05ffa3..72f4a5a5 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,13 @@
 .set CTRL_SPAN_BIT, BIT23
 
 ASM_FUNC (_ModuleEntryPoint)
+  // Keep x0..x3 of the previous stage: the DT a Linux-style boot loader hands
+  // over, and the embedded payload BootShim may describe. The slots are in
+  // this section, which is in RAM here.
+  adr   x4, ASM_PFX (gSecEntryArgs)
+  stp   x0, x1, [x4]
+  stp   x2, x3, [x4, #16]
+
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
@@ -61,3 +68,9 @@ ASM_PFX (MainEntryPoint):
 
   // Do Infinite Spin
   b     .
+
+  // Arguments x0..x3 of the previous stage, written once at entry
+  .align 3
+  .global ASM_PFX (gSecEntryArgs)
+ASM_PFX (gSecEntryArgs):
+  .quad 0, 0, 0, 0
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
index 8d586b35..f9779e40 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
+++ b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
@@ -17,6 +17,10 @@
 #include <Library/HobLib.h>
 
 #include "Sec.h"
+#include <Guid/SiliciumEntryArgs.h>
+
+// Arguments x0..x3 of the previous stage, saved by ModuleEntryPoint.S
+extern UINT64  gSecEntryArgs[4];
 
 #ifndef MDEPKG_NDEBUG
 STATIC
@@ -130,6 +134,38 @@ SecMain (VOID)
     return;
   }
 
+  // Pass on what the previous stage handed over, so DXE drivers can use it:
+  // x0 is a DT address for a Linux-style boot loader, x1..x3 describe a
+  // payload BootShim left after the FD.
+  {
+    UINT64                EntryArg = gSecEntryArgs[0];
+    EMBEDDED_PAYLOAD_HOB  Payload;
+
+    BuildGuidDataHob (&gSiliciumEntryArgHobGuid, &EntryArg, sizeof (EntryArg));
+
+    if (gSecEntryArgs[3] == EMBEDDED_PAYLOAD_MAGIC && gSecEntryArgs[1] != 0 && gSecEntryArgs[2] != 0) {
+      EFI_MEMORY_REGION_DESCRIPTOR  KernelRegion;
+
+      Payload.Base = gSecEntryArgs[1];
+      Payload.Size = gSecEntryArgs[2];
+
+      // The payload stays where the boot loader loaded the image. Only trust it
+      // inside the "Kernel" window: anywhere else SEC's own stack and heaps
+      // may already have overwritten it.
+      ZeroMem (&KernelRegion, sizeof (KernelRegion));
+      LocateMemoryRegionByName ("Kernel", &KernelRegion);
+      if (KernelRegion.Length != 0 &&
+          Payload.Base >= KernelRegion.Address &&
+          Payload.Size <= KernelRegion.Length &&
+          Payload.Base - KernelRegion.Address <= KernelRegion.Length - Payload.Size) {
+        BuildGuidDataHob (&gSiliciumEmbeddedPayloadHobGuid, &Payload, sizeof (Payload));
+        DEBUG ((EFI_D_WARN, "Embedded Payload at 0x%lx, 0x%lx Bytes\n", Payload.Base, Payload.Size));
+      } else {
+        DEBUG ((EFI_D_ERROR, "Embedded Payload at 0x%lx, 0x%lx Bytes is outside the Kernel Region 0x%lx, 0x%lx Bytes!\n", Payload.Base, Payload.Size, KernelRegion.Address, KernelRegion.Length));
+      }
+    }
+  }
+
   // Run Library Cconstructors
   ProcessLibraryConstructorList ();
 
