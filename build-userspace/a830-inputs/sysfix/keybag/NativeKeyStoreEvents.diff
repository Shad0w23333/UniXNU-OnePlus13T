+void note(uint32_t kind, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+void note(uint32_t kind, const char *fmt, ...) {
+    if (kind && (__atomic_fetch_or(&gKeybag.noted, kind, __ATOMIC_RELAXED) & kind)) return;
+    char line[128];
