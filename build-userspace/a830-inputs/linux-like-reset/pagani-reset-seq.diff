+    if (mask & RAMOOPS_RESET_SEQ_SPMI) put_str(t, " spmi-halt");
+    if (mask & RAMOOPS_RESET_SEQ_CPUS) put_str(t, " park-cpus");
+    if (mask & RAMOOPS_RESET_SEQ_OEM) put_str(t, " oem-warm-reboot");
+    if (cold) put_str(t, " pagani-reset-cold");
+}
