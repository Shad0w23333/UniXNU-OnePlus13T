+// The reset path's records take the lock by force (a stopped holder must not hold back a reset).
+static void reset_seq_record(char kind, const char *text)
+{
+    if (!log_on()) return;
+    uint64_t flags = lock_log(1);
+    emit_text(kind, text);
+    unlock_log(flags);
+}
