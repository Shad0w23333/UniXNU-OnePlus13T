+void ramoops_platform_wdog_release(const char *reason)
+{
+    assert(reason);
+    pthread_mutex_lock(&platform_lock);
+    release_calls++;
+    trace_add(TRACE_RELEASE);
+    pthread_mutex_unlock(&platform_lock);
+}
