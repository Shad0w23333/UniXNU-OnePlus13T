+__attribute__((noreturn)) static void reset_park_cpu(void *param)
+{
+    __asm__ volatile("msr daifset, #15" ::: "memory");
+    __atomic_add_fetch((uint32_t *)param, 1, __ATOMIC_RELEASE);
+    for (;;) __asm__ volatile("wfe\n\twfi" ::: "memory");
