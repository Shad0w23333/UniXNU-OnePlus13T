+DIAG_FILES = (('paganidiag', 'ngpu/bin/paganidiag', 0o755), ('paganidiag.conf', 'ngpu/bin/paganidiag.conf', 0o644),
+              ('com.apple.migration.plist', 'preferences/Logging/Subsystems/com.apple.migration.plist', 0o644),
