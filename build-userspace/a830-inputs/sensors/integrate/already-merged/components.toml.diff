+
+[[component]]
+id = "PaganiSensors"
+kind = "driver"
+function = "OnePlus 13T sensors for iOS: ambient light, proximity, accelerometer, gyroscope, magnetometer (and a barometer when present) from the ADSP sensor hub (QMI sensor client service 400 over PaganiAdsp's IPC router) as IOHIDEventDriver services with the original 21H461 IOHIDEvent constructors"
+scope = "community"
+repository = "https://github.com/IssacL04/UniXNU-Pagani-Drivers.git"
+revision = "<commit>"
+path = "drivers/PaganiSensors"
+hardware = ["OnePlus 13T PKX110", "SM8750"]
+os_abi = ["ipados-17.7.11-21H461"]
+board_dependencies = ["Stage7Probe calls pagani_sensors_start after pagani_adsp_start", "pagani-sensors=1/2/3 (absent: off); 2 and 3 need pagani-adsp=1", "the ADSP sensor PD's registry (FastRPC file service, not provided yet) for physical sensors"]
+verified_devices = []
+dependencies = ["Adreno830", "PaganiAdsp", "PaganiInput", "NativeMobileDisplay", "Stage7Probe", "BootProgress"]
+source_files = ["PaganiSensors.cpp", "PaganiSensorsHid.cpp", "SensorsCore.c", "SensorsSsc.c", "SensorsPb.c", "SensorsFixed.c", "SensorsHid.c"]
+runtime_identifiers = ["PaganiSensorHid", "pagani_sensors_start", "pagani_sensors_status"]
+build_stage = "kernel"
+build = ["{component}/scripts/build-pagani-sensors.py", "--kernelcache", "{out}/../../../ipsw/21H461/kernelcache.decompressed", "--append-to", "{tree}/build/adreno830/libAdreno830.a"]
+outputs = ["build/pagani-sensors/libPaganiSensors.a"]
