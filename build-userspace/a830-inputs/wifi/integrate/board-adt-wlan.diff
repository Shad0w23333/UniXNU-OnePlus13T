+# name-only child of /product, like accel/gyro: no nub, no driver matches it. Apply together with pagani-wifi=6 and after the first
+# image has shown en0 up (wifid against no interface is untested); /chosen/mac-address-wifi0 is written by the driver at run time.
+[adt.product.wlan]
+
 [adt.buttons.string]
 compatible = "buttons"
 device_type = "buttons"
