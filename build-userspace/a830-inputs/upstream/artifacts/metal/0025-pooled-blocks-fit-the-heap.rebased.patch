+/// Turnip's memory properties on the Adreno 830 as a connection's GPU window bounds them: one heap
+/// of the window's size (`tu_get_system_heap_size` caps the heap at the kernel's `va_size`), a
+/// write-combined and a host-cached coherent type in it.
+fn turnip(heap: u64) -> vk::PhysicalDeviceMemoryProperties {
+    use vk::MemoryPropertyFlags as P;
+    let mut properties = vk::PhysicalDeviceMemoryProperties {
+        memory_type_count: 2,
+        memory_heap_count: 1,
+        ..Default::default()
+    };
+    properties.memory_types[0] = ty(P::DEVICE_LOCAL | P::HOST_VISIBLE | P::HOST_COHERENT);
+    properties.memory_types[1] =
+        ty(P::DEVICE_LOCAL | P::HOST_VISIBLE | P::HOST_COHERENT | P::HOST_CACHED);
+    properties.memory_heaps[0] = vk::MemoryHeap {
+        size: heap,
+        flags: vk::MemoryHeapFlags::DEVICE_LOCAL,
+    };
+    properties
+}
+
+/// A pooled block is at most a sixteenth of the smallest heap, a power of two of at least 1 MiB,
+/// never past the device's largest allocation, and `BLOCK_BYTES` on a device whose heaps are 1 GiB
+/// or larger. An Adreno 830 app's 124 MiB window took 64 MiB blocks, so a block of buffers left no
+/// room for the first texture's block of images (Find My's VectorKit atlas, refused).
+#[test]
+fn pooled_blocks_fit_the_heap() {
+    use crate::memory::{block_bytes, BLOCK_BYTES, HEAP_SHARE, MIN_BLOCK_BYTES};
+    const MIB: u64 = 1 << 20;
+    let max = 0xFFFF_FFFF;
+    // The Adreno 830's client windows (Adreno830 NativeAdrenoClientWindows4G/16G): the render
+    // server's 1.5 GiB keeps 64 MiB, a large client's 352 MiB takes 16 MiB, an app's 124 MiB 4 MiB,
+    // a 16 GiB aperture's small 448 MiB 16 MiB, the 2 GiB table's 170 MiB 8 MiB.
+    for (heap, block) in [
+        (1536 * MIB, 64 * MIB),
+        (0x1600_0000, 16 * MIB),
+        (0x07C0_0000, 4 * MIB),
+        (0x1C00_0000, 16 * MIB),
+        (0x0AAA_9000, 8 * MIB),
+        (8 << 30, BLOCK_BYTES),
+        (1 << 30, BLOCK_BYTES),
+        (16 * MIB, MIB),
+        (4 * MIB, MIN_BLOCK_BYTES),
+    ] {
+        let bytes = block_bytes(&turnip(heap), max);
+        assert_eq!(bytes, block, "heap {heap:#x}");
+        assert!(bytes.is_power_of_two());
+        assert!(bytes <= BLOCK_BYTES && (bytes * HEAP_SHARE <= heap || bytes == MIN_BLOCK_BYTES));
+        // Half a block stays whole units of a heap's base (`buffer.rs`'s `placed`).
+        assert!((bytes / 2).is_multiple_of(crate::texture::heap::HEAP_BASE_ALIGNMENT));
+    }
+    // The device's largest allocation still bounds it, as before.
+    assert_eq!(block_bytes(&turnip(8 << 30), 48 * MIB), 48 * MIB);
+    assert_eq!(block_bytes(&turnip(0x07C0_0000), 2 * MIB), 2 * MIB);
+    // No heap reported (the tests' properties), or heaps of no size: as before.
+    let mut none = turnip(0);
+    assert_eq!(block_bytes(&none, max), BLOCK_BYTES);
+    none.memory_heap_count = 0;
+    assert_eq!(block_bytes(&none, max), BLOCK_BYTES);
+    // The smallest heap an allocatable type lies in counts: a 256 MiB BAR heap beside 16 GiB of
+    // video memory takes 16 MiB; a heap only AMD's device-coherent types lie in is not one the
+    // runtime allocates from.
+    use vk::MemoryPropertyFlags as P;
+    let mut split = turnip(16 << 30);
+    split.memory_heap_count = 2;
+    split.memory_heaps[1] = vk::MemoryHeap {
+        size: 256 * MIB,
+        flags: vk::MemoryHeapFlags::DEVICE_LOCAL,
+    };
+    split.memory_types[1] = vk::MemoryType {
+        property_flags: P::DEVICE_LOCAL | P::HOST_VISIBLE | P::HOST_COHERENT,
+        heap_index: 1,
+    };
+    assert_eq!(block_bytes(&split, max), 16 * MIB);
+    split.memory_types[1].property_flags |= P::DEVICE_COHERENT_AMD;
+    assert_eq!(block_bytes(&split, max), BLOCK_BYTES);
+}
