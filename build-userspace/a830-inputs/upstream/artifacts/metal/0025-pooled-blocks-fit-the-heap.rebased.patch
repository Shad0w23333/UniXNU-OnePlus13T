+/// The most of a memory heap one pooled block takes: one sixteenth. A device holds a block in
+/// each pool it places into (a memory type's buffers and its images apart, [`Holds`]), keeps
+/// room in up to four pools ahead of every creation call ([`keep_room`]) and keeps one empty
+/// block a pool, so about eight blocks may stand while the program holds little in them: half
+/// the heap at this share. Turnip reports a heap no larger than the process's GPU address window
+/// (`tu_get_system_heap_size` caps it at the kernel's `va_size`), and on the Adreno 830 an app's
+/// window is 124 MiB: with blocks of [`BLOCK_BYTES`] one block of buffers left no room for a
+/// block of images, so Find My's first texture, VectorKit's 128x128 `R8Unorm` atlas, was
+/// refused out of device memory (`newTexture` returned nil and VectorKit aborted).
+pub(super) const HEAP_SHARE: u64 = 16;
+
+/// The smallest pooled block: a placement past half of it takes a block of its own.
+pub(super) const MIN_BLOCK_BYTES: u64 = 1 << 20;
+
+/// The size of a pooled block on a device of memory `properties` whose largest allocation is
+/// `max_allocation` bytes: [`BLOCK_BYTES`], at most a [`HEAP_SHARE`]th of the smallest heap an
+/// allocatable memory type lies in, as a power of two of at least [`MIN_BLOCK_BYTES`], and never
+/// past `max_allocation`. A device whose heaps are all 1 GiB or larger (or that reports none)
+/// keeps [`BLOCK_BYTES`]: a 124 MiB heap takes 4 MiB blocks, a 352 MiB one 16 MiB, 448 MiB 16 MiB.
+pub(super) fn block_bytes(
+    properties: &vk::PhysicalDeviceMemoryProperties,
+    max_allocation: u64,
+) -> u64 {
+    let types = &properties.memory_types
+        [..(properties.memory_type_count as usize).min(vk::MAX_MEMORY_TYPES)];
+    let heaps = &properties.memory_heaps
+        [..(properties.memory_heap_count as usize).min(vk::MAX_MEMORY_HEAPS)];
+    let smallest = (types.iter())
+        .filter(|ty| allocatable(ty.property_flags))
+        .filter_map(|ty| heaps.get(ty.heap_index as usize))
+        .map(|heap| heap.size)
+        .filter(|&size| size > 0)
+        .min();
+    let share = smallest.map_or(BLOCK_BYTES, |size| (size / HEAP_SHARE).min(BLOCK_BYTES));
+    // The largest power of two within the share: half a block (from 512 KiB) stays a whole
+    // number of a heap's 256 KiB base units, which `buffer.rs`'s `placed` rounds a heap up to,
+    // so that rounding never carries a pooled placement past half a block.
+    let power = match share {
+        0 => 0,
+        share => 1 << (63 - share.leading_zeros()),
+    };
+    power.max(MIN_BLOCK_BYTES).min(max_allocation.max(1))
+}
