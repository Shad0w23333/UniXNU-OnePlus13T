+static inline void dsi_panel_snapshot(const struct peripheral_io *io,struct dsi_panel_state *s) {
+    s->version=peripheral_read(io,0x000);s->ctrl=peripheral_read(io,0x004);s->status=peripheral_read(io,0x008);
