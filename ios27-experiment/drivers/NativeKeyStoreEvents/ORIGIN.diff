diff -ruN -x ORIGIN.md -x ORIGIN.sha256 -x ORIGIN.diff -x __pycache__ -x .DS_Store a/KeyStoreProbe.cpp b/KeyStoreProbe.cpp
--- a/KeyStoreProbe.cpp	1969-12-31 16:00:00
+++ b/KeyStoreProbe.cpp	2026-11-01 12:30:58
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Ported from UniXNU-sheng package/KeyStoreProbe.cpp (6b11bb5e40aabc75545a3dac87a92dbfde52c806), Copyright (c) 2026, UniXNU contributors, with
+// the start logic of this project's Stage7Probe (startKeyState).
+// Starts NativeKeyStoreEvents on a kernel without the display stack, whose late probe starts it otherwise: SourceStorage.cpp calls it. A kernel
+// that links Stage7Probe already has these hooks and must not link this file.
+#include <IOKit/IOService.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSSymbol.h>
+#include <pexpert/pexpert.h>
+#include <mach/kmod.h>
+
+extern kmod_info_t g_kernel_kmod_info;
+extern "C" void native_keyevents_static_init(void) __asm__("__GLOBAL__sub_I_NativeKeyStoreEvents.cpp");
+extern "C" IOService *native_keyevents_allocate(void);
+extern "C" void boot_progress_trace(const char *text);    // BootProgress: one U line in the ramoops log
+
+static bool stateEnabled, storageVolatile, attempted;
+static uint32_t aksOpens, aksCalls;
+
+static void note(const char *what, uint64_t value)
+{
+    char line[80];
+    snprintf(line, sizeof(line), "keystore: %s %llx", what, value);
+    boot_progress_trace(line);
+}
+
+static bool enabled(const char *name)
+{
+    unsigned value = 0;
+    return PE_parse_boot_argn(name, &value, sizeof(value)) && value == 1;
+}
+
+// `/chosen ephemeral-storage` = 1: the Data volume is a RAM disk made from the seed every boot.
+static bool ephemeralStorage(void)
+{
+    // An explicit plane requires a path without a second plane prefix.
+    IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+    OSData *data = chosen ? OSDynamicCast(OSData, chosen->getProperty("ephemeral-storage")) : nullptr;
+    uint32_t ephemeral = 0;
+    if (data && data->getLength() == sizeof(ephemeral)) memcpy(&ephemeral, data->getBytesNoCopy(), sizeof(ephemeral));
+    OSSafeReleaseNULL(chosen);
+    return ephemeral == 1;
+}
+
+extern "C" {
+void native_keyevents_open_refused(void) { note("open refused", 0); }
+bool native_aks_state_enabled(void) { return stateEnabled; }
+bool native_aks_storage_volatile(void) { return storageVolatile; }
+uint32_t native_aks_lock_state(void) { return 0; }
+void native_aks_call(uint32_t selector, int32_t result)
+{
+    aksCalls = aksCalls + 1;
+    if (result) note("operation unavailable", selector);
+}
+void native_aks_opened(void) { aksOpens = aksOpens + 1; }
+
+void native_keystore_probe(void)
+{
+    if (attempted || !enabled("offline-key-events") || !enabled("sheng-aks")) return;
+    attempted = true;
+    // A persistent Data store still has no SEP, so the service stays for it (sheng's change), but not the volatile keybag: per-boot class keys
+    // would make every keychain item of an earlier boot undecryptable, and securityd then drops them. AppleKeyStore::start reads this.
+    storageVolatile = ephemeralStorage();
+    const OSSymbol *name = OSSymbol::withCString("AppleKeyStore");
+    const bool absent = name && !OSMetaClass::getMetaClassWithName(name);
+    OSSafeReleaseNULL(name);
+    IOService *provider = IOService::getResourceService();
+    if (!absent || !provider) { note("not started: class present or no provider", absent); return; }
+    void *handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name);
+    if (!handle) { note("class registration refused", 0); return; }
+    native_keyevents_static_init();
+    const OSReturn status = OSMetaClass::postModLoad(handle);
+    if (status != kOSReturnSuccess) { note("class registration failed", static_cast<uint32_t>(status)); return; }
+    IOService *service = native_keyevents_allocate();
+    const bool attached = service && service->init() && service->attach(provider);
+    // Publish state queries only after the guards above passed.
+    stateEnabled = true;
+    if (attached && service->start(provider)) { note("started, volatile storage", storageVolatile); return; }
+    stateEnabled = false;
+    if (attached) service->detach(provider);
+    OSSafeReleaseNULL(service);
+    note("start failed", 0);
+}
+}
