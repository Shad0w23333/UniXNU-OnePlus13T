diff -ruN -x ORIGIN.md -x ORIGIN.sha256 -x ORIGIN.diff -x __pycache__ -x .DS_Store a/SourceRootBinding.cpp b/SourceRootBinding.cpp
--- a/SourceRootBinding.cpp	1969-12-31 16:00:00
+++ b/SourceRootBinding.cpp	2026-11-01 12:22:30
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Ported from UniXNU-sheng package/SourceRootBinding.cpp (6b11bb5e40aabc75545a3dac87a92dbfde52c806), Copyright (c) 2026, UniXNU contributors.
+// Bind a mounted BSD device to an owner-verified UFS root window.
+//
+// The owner-root kernel patches ask these queries after mounting: the device
+// must be the BSD node of exactly one IOMedia whose provider chain reaches a
+// NativeUfs window that verified the media's volume UUID.
+#include <IOKit/IOService.h>
+#include <IOKit/IOBSD.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSIterator.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+#include <sys/types.h>
+#include <sys/param.h>
+
+extern "C" {
+int native_ufs_block_authenticates(IOService *provider, const char *uuid, uint8_t *digest);
+int native_verified_block_root_authorized(dev_t device);
+int native_verified_block_manifest_sha384(dev_t device, const char *uuid, uint8_t digest[48]);
+int native_verified_block_volume_device(const char *uuid, dev_t *device, char *path, size_t size);
+}
+
+static constexpr size_t kDigestBytes = 48;
+
+// 1 when `device` is the only IOMedia with that BSD number and a UFS window
+// below it authenticates the media UUID (and `expectedUUID`, when given).
+static int verifiedVolumeQuery(dev_t device, const char *expectedUUID, uint8_t *manifestDigest)
+{
+    OSDictionary *matching = IOService::serviceMatching("IOMedia");
+    OSDictionary *properties = OSDictionary::withCapacity(2);
+    OSNumber *mjr = OSNumber::withNumber(static_cast<unsigned>(major(static_cast<uint32_t>(device))), 32);
+    OSNumber *mnr = OSNumber::withNumber(static_cast<unsigned>(minor(static_cast<uint32_t>(device))), 32);
+    bool ready = matching && properties && mjr && mnr &&
+                 properties->setObject(kIOBSDMajorKey, mjr) && properties->setObject(kIOBSDMinorKey, mnr) &&
+                 matching->setObject("IOPropertyMatch", properties);
+    OSSafeReleaseNULL(mnr);
+    OSSafeReleaseNULL(mjr);
+    OSSafeReleaseNULL(properties);
+    OSIterator *iterator = ready ? IOService::getMatchingServices(matching) : nullptr;
+    OSSafeReleaseNULL(matching);
+    if (!iterator) return 0;
+    bool authenticated = false;
+    unsigned matches = 0;
+    while (OSObject *object = iterator->getNextObject()) {
+        IOService *media = OSDynamicCast(IOService, object);
+        if (!media) continue;
+        if (++matches != 1) { authenticated = false; break; }
+        OSString *uuid = OSDynamicCast(OSString, media->getProperty("UUID"));
+        if (!uuid || uuid->getLength() != 36 ||
+            (expectedUUID && strcmp(expectedUUID, uuid->getCStringNoCopy()))) continue;
+        unsigned depth = 0;
+        for (IOService *provider = media; provider && depth < 64; provider = provider->getProvider(), ++depth) {
+            const int ufs = native_ufs_block_authenticates(provider, uuid->getCStringNoCopy(), manifestDigest);
+            if (ufs >= 0) {
+                authenticated = ufs == 1;
+                break;
+            }
+        }
+    }
+    iterator->release();
+    if (!authenticated || matches != 1) {
+        if (manifestDigest) bzero(manifestDigest, kDigestBytes);
+        return 0;
+    }
+    return 1;
+}
+
+extern "C" int native_verified_block_root_authorized(dev_t device)
+{
+    return verifiedVolumeQuery(device, nullptr, nullptr);
+}
+
+extern "C" int native_verified_block_manifest_sha384(dev_t device, const char *uuid, uint8_t digest[48])
+{
+    if (!digest) return 0;
+    bzero(digest, kDigestBytes);
+    if (!uuid || strlen(uuid) != 36) return 0;
+    return verifiedVolumeQuery(device, uuid, digest);
+}
+
+extern "C" int native_verified_block_volume_device(const char *uuid, dev_t *device, char *path, size_t size)
+{
+    if (!uuid || !device || !path || size < 6 || strlen(uuid) != 36) return 0;
+    *device = NODEV;
+    path[0] = 0;
+    OSDictionary *matching = IOService::serviceMatching("IOMedia");
+    OSDictionary *properties = OSDictionary::withCapacity(1);
+    OSString *wanted = OSString::withCString(uuid);
+    bool ready = matching && properties && wanted && properties->setObject("UUID", wanted) &&
+                 matching->setObject("IOPropertyMatch", properties);
+    OSSafeReleaseNULL(wanted);
+    OSSafeReleaseNULL(properties);
+    OSIterator *iterator = ready ? IOService::getMatchingServices(matching) : nullptr;
+    OSSafeReleaseNULL(matching);
+    if (!iterator) return 0;
+    unsigned matches = 0;
+    bool authenticated = false;
+    dev_t candidate = NODEV;
+    char candidatePath[64] = {};
+    while (OSObject *object = iterator->getNextObject()) {
+        IOService *media = OSDynamicCast(IOService, object);
+        if (!media) continue;
+        if (++matches != 1) { authenticated = false; break; }
+        OSString *identity = OSDynamicCast(OSString, media->getProperty("UUID"));
+        OSString *name = OSDynamicCast(OSString, media->getProperty(kIOBSDNameKey));
+        OSNumber *mjr = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMajorKey));
+        OSNumber *mnr = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMinorKey));
+        if (!identity || strcmp(identity->getCStringNoCopy(), uuid) || !name || !mjr || !mnr ||
+            !name->getLength() || name->getLength() >= sizeof(candidatePath) - 6 || name->getLength() >= size - 6 ||
+            mjr->unsigned64BitValue() > 255 || mnr->unsigned64BitValue() > 0xffffff) continue;
+        candidate = static_cast<dev_t>(makedev(mjr->unsigned32BitValue(), mnr->unsigned32BitValue()));
+        if (!native_verified_block_root_authorized(candidate)) continue;
+        snprintf(candidatePath, sizeof(candidatePath), "/dev/%s", name->getCStringNoCopy());
+        authenticated = true;
+    }
+    iterator->release();
+    if (!authenticated || matches != 1) return 0;
+    *device = candidate;
+    strlcpy(path, candidatePath, size);
+    return 1;
+}
diff -ruN -x ORIGIN.md -x ORIGIN.sha256 -x ORIGIN.diff -x __pycache__ -x .DS_Store a/SourceRootPolicies.cpp b/SourceRootPolicies.cpp
--- a/SourceRootPolicies.cpp	1969-12-31 16:00:00
+++ b/SourceRootPolicies.cpp	2026-11-01 12:22:30
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Ported from UniXNU-sheng package/SourceRootPolicies.cpp (6b11bb5e40aabc75545a3dac87a92dbfde52c806), Copyright (c) 2026, UniXNU contributors.
+// Authenticate the firmware's root-policy sidecar with a compiled-in owner key.
+#include <IOKit/IOService.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_map.h>
+#include <vm/vm_kern_xnu.h>
+#include <mach/mach_vm.h>
+#include "verified_root.h"
+#include "VerifiedBlockPolicy.h"
+
+extern "C" {
+extern const uint8_t verified_root_key[];
+extern const struct vr_crypto vr_xnu_crypto;
+NativeVerifiedBlockPolicy verified_root_policies[16];
+uint64_t verified_root_policy_count;
+}
+
+static uint64_t read64(const uint8_t *p)
+{
+    uint64_t n = 0;
+    for (unsigned i = 0; i != 8; ++i) n |= uint64_t(p[i]) << (i * 8);
+    return n;
+}
+
+extern "C" bool native_source_root_policies_load(void)
+{
+    if (verified_root_policy_count) return true;
+    IORegistryEntry *entry = IORegistryEntry::fromPath("/chosen/memory-map", gIODTPlane);
+    if (!entry) return false;
+    OSData *property = OSDynamicCast(OSData, entry->getProperty("RootPolicies"));
+    uint64_t physical = 0, length = 0;
+    if (property && property->getLength() == 16) {
+        const auto *data = static_cast<const uint8_t *>(property->getBytesNoCopy());
+        physical = read64(data);
+        length = read64(data + 8);
+    }
+    entry->release();
+    if (!physical || (physical & 4095) || length < 32 || length > 128ULL * 1024 * 1024 ||
+        physical > UINT64_MAX - length) return false;
+    IOMemoryDescriptor *descriptor = IOMemoryDescriptor::withPhysicalAddress(physical, length, kIODirectionIn);
+    if (!descriptor) return false;
+    IOMemoryMap *mapping = descriptor->map();
+    if (!mapping) { descriptor->release(); return false; }
+    vm_offset_t allocation = 0;
+    const vm_size_t allocationBytes = round_page(static_cast<vm_size_t>(length));
+    const kern_return_t allocated = kmem_alloc(kernel_map, &allocation, allocationBytes,
+        static_cast<kma_flags_t>(KMA_KOBJECT | KMA_DATA), VM_KERN_MEMORY_SECURITY);
+    if (allocated == KERN_SUCCESS)
+        memcpy(reinterpret_cast<void *>(allocation), reinterpret_cast<const void *>(mapping->getVirtualAddress()), length);
+    mapping->release();
+    descriptor->release();
+    if (allocated != KERN_SUCCESS) return false;
+    // Protect the copied bytes before authenticating; later firmware or source
+    // mappings cannot alter the data from which we publish policy pointers.
+    if (mach_vm_protect(kernel_map, allocation, allocationBytes, TRUE, VM_PROT_READ) != KERN_SUCCESS)
+        return false;
+    const auto *bytes = reinterpret_cast<const uint8_t *>(allocation);
+    if (memcmp(bytes, "VROOTB01", 8) || read64(bytes + 8) != 1 || read64(bytes + 24) != length)
+        return false;
+    const uint64_t count = read64(bytes + 16);
+    if (!count || count > 16 || 32 + count * 16 > length) return false;
+    uint64_t cursor = 32 + count * 16;
+    for (uint64_t i = 0; i != count; ++i) {
+        const uint64_t offset = read64(bytes + 32 + i * 16);
+        const uint64_t size = read64(bytes + 40 + i * 16);
+        if (offset != cursor || size < VR_HEADER_BYTES + VR_SIGNATURE_BYTES || size > length - cursor)
+            return false;
+        // A policy is either the whole envelope or only its signed header, whose hash table
+        // is a userdata object that NativeUfs reads and checks against the signed digest.
+        struct vr_view view = {};
+        const bool headerOnly = size == VR_HEADER_BYTES + VR_SIGNATURE_BYTES;
+        if ((headerOnly ? vr_open_header(bytes + offset, size, verified_root_key, 1, &vr_xnu_crypto, &view) :
+                          vr_open(bytes + offset, size, verified_root_key, 1, &vr_xnu_crypto, &view)) != VR_OK)
+            return false;
+        verified_root_policies[i] = {bytes + offset, size};
+        cursor += size;
+    }
+    if (cursor != length) return false;
+    verified_root_policy_count = count;
+    return true;
+}
diff -ruN -x ORIGIN.md -x ORIGIN.sha256 -x ORIGIN.diff -x __pycache__ -x .DS_Store a/SourceStorage.cpp b/SourceStorage.cpp
--- a/SourceStorage.cpp	1969-12-31 16:00:00
+++ b/SourceStorage.cpp	2026-11-01 12:32:01
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Ported from UniXNU-sheng package/SourceStorage.cpp (6b11bb5e40aabc75545a3dac87a92dbfde52c806), Copyright (c) 2026, UniXNU contributors.
+// Start the source-built UFS adapter after the original storage family loads.
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/storage/IOBlockStorageDevice.h>
+#include <libkern/OSKextLib.h>
+#include <mach/kmod.h>
+#include <pexpert/pexpert.h>
+#include <IOKit/IOLib.h>
+
+extern kmod_info_t g_kernel_kmod_info;
+extern "C" void source_storage_base_init(void) __asm__("__GLOBAL__sub_I_IOBlockStorageDevice.cpp");
+extern "C" void source_storage_ufs_init(void) __asm__("__GLOBAL__sub_I_NativeUfs.cpp");
+extern "C" void source_storage_ram_init(void) __asm__("__GLOBAL__sub_I_NativeRamBlock.cpp");
+extern "C" IOService *native_ufs_source_create(void);
+extern "C" bool native_source_root_policies_load(void);
+// NativeUfs records how far root start got and the last soft-failure reason.
+extern "C" volatile uint32_t native_ufs_root_step;
+extern "C" const char *volatile native_ufs_root_failure;
+
+// NativeUfs polls the optional board diagnostic during window reads. The
+// minimal kernel does not include it; a weak definition keeps the archive
+// linkable and is replaced when the diagnostic component is built in.
+extern "C" __attribute__((weak)) void boot_progress_poll(void) {}
+// Starts NativeKeyStoreEvents (KeyStoreProbe.cpp) on a kernel without the display stack; one with it does that from its late probe and
+// does not link KeyStoreProbe.cpp, so this stays a no-op.
+extern "C" __attribute__((weak)) void native_keystore_probe(void) {}
+static const OSMetaClass *storageParent;
+static IOService *storageDriver;
+static bool attempted;
+
+// Used only by the deferred source IOBlockStorageDevice metaclass constructor.
+// The C++ class name stays unchanged for compiler-authored arm64e discriminators.
+extern "C" const OSMetaClass *native_source_storage_parent(void)
+{
+    if (!storageParent) panic("SourceStorage: metaclass initialized before original family");
+    return storageParent;
+}
+
+// The Data seed the loader placed in /chosen/memory-map. Its disk starts after UFS, whose store window
+// keeps the changed pages of the seed when the board enables persistence.
+static void start_data_disk(IOService *provider)
+{
+    IORegistryEntry *map = IORegistryEntry::fromPath("/chosen/memory-map", gIODTPlane);
+    const bool seed = map && (map->getProperty("PackedRAMDisk") || map->getProperty("RAMDisk"));
+    OSSafeReleaseNULL(map);
+    if (!seed) return;
+    IOService *disk = OSDynamicCast(IOService, OSMetaClass::allocClassWithName("NativeRamBlock"));
+    if (!disk) panic("SourceStorage: cannot allocate the Data disk");
+    const char *step = !disk->init() ? "init" : !disk->attach(provider) ? "attach" : !disk->start(provider) ? "start" : nullptr;
+    if (step) panic("SourceStorage: Data disk %s failed", step);
+    printf("SourceStorage: Data disk started\n");
+}
+
+extern "C" void native_source_storage_start(void)
+{
+    unsigned enabled = 0;
+    if (!PE_parse_boot_argn("native-source-storage", &enabled, sizeof(enabled)) || enabled != 1 || attempted)
+        return;
+    attempted = true;
+    OSReturn status = OSKextLoadKextWithIdentifier("com.apple.iokit.IOStorageFamily");
+    if (status != kOSReturnSuccess)
+        panic("SourceStorage: IOStorageFamily load failed %x", status);
+    const OSSymbol *name = OSSymbol::withCString("IOBlockStorageDevice");
+    storageParent = name ? OSMetaClass::getMetaClassWithName(name) : nullptr;
+    if (name) name->release();
+    if (!storageParent || storageParent->getClassSize() != sizeof(IOBlockStorageDevice))
+        panic("SourceStorage: original base layout %u differs from source %lu",
+              storageParent ? storageParent->getClassSize() : 0, sizeof(IOBlockStorageDevice));
+
+    // Authenticate policies before registering hardware-facing classes. The
+    // firmware hands off the envelope; the trusted anchor is compiled in.
+    if (!native_source_root_policies_load())
+        panic("SourceStorage: root policy handoff or authentication failed");
+    status = OSKextLoadKextWithIdentifier("com.apple.filesystems.apfs");
+    if (status != kOSReturnSuccess)
+        panic("SourceStorage: APFS load failed %x", status);
+    void *handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name);
+    if (!handle) panic("SourceStorage: cannot begin class registration");
+    source_storage_base_init();
+    source_storage_ufs_init();
+    source_storage_ram_init();
+    status = OSMetaClass::postModLoad(handle);
+    if (status != kOSReturnSuccess)
+        panic("SourceStorage: class registration failed %x", status);
+
+    OSDictionary *matching = IOService::serviceMatching("IOPlatformExpertDevice");
+    IOService *provider = matching ? IOService::waitForMatchingService(matching, 5000000000ULL) : nullptr;
+    if (!provider) panic("SourceStorage: platform root unavailable");
+    storageDriver = native_ufs_source_create();
+    if (!storageDriver) panic("SourceStorage: cannot allocate UFS service");
+    const char *step = !storageDriver->init() ? "init" : !storageDriver->attach(provider) ? "attach" :
+                       !storageDriver->start(provider) ? "start" : nullptr;
+    if (step)
+        panic("SourceStorage: UFS %s failed (root step %u: %s)", step, native_ufs_root_step,
+              native_ufs_root_failure ? native_ufs_root_failure : "no reason recorded");
+    printf("SourceStorage: UFS started through public IOStorageFamily interface\n");
+    start_data_disk(provider);
+    // The UFS log area exists from here on. BootProgress's writer (UfsLog.c, sheng-log=1) has been asking for it since boot_progress_start:
+    // until startRoot has read the root layout its open is refused with "no root layout", and it tries again every second.
+    native_keystore_probe();
+}
