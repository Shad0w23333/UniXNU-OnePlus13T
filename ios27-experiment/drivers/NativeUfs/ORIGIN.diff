diff -ruN -x ORIGIN.md -x ORIGIN.sha256 -x ORIGIN.diff -x __pycache__ -x .DS_Store a/tests/RootBase.cpp b/tests/RootBase.cpp
--- a/tests/RootBase.cpp	1969-12-31 16:00:00
+++ b/tests/RootBase.cpp	2026-11-01 12:13:16
@@ -0,0 +1,265 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// The root base (pagani-root-base-mib) and the version 2 manifest: the kernel's parser, plans and object read against a model LUN laid out
+// like the 13T's `unixnu` partition, with the iPadOS 17 image at its start and iPadOS 27 images at 10240 MiB and 27648 MiB. Host only.
+#define OPENSSL_SUPPRESS_DEPRECATED
+#include <openssl/sha.h>
+#include <array>
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <vector>
+#include "../RootDiagnostics.h"
+using IOReturn=uint32_t;
+constexpr IOReturn kIOReturnSuccess=0, kIOReturnBadArgument=1, kIOReturnIOError=2;
+constexpr unsigned kDataMax=131072;
+static UfsRootDiagnostics gRootDiagnostic;
+static std::map<uint64_t,std::array<uint8_t,4096>> lun;       // blank when absent
+static std::vector<uint64_t> readLbas;
+static std::vector<uint32_t> readBlocks;
+static uint64_t failAt=UINT64_MAX;
+static IOReturn hostRead4k(uint8_t,uint64_t lba,uint32_t blocks,void *out)
+{
+  assert(blocks && blocks<=kDataMax/4096);
+  readLbas.push_back(lba); readBlocks.push_back(blocks);
+  for(uint32_t i=0;i<blocks;++i) {
+    if(lba+i==failAt) return 1;
+    auto f=lun.find(lba+i);
+    if(f==lun.end()) memset(static_cast<uint8_t *>(out)+i*4096ULL,0,4096);
+    else memcpy(static_cast<uint8_t *>(out)+i*4096ULL,f->second.data(),4096);
+  }
+  return 0;
+}
+#include "../RootLayout.h"
+#include "../RootWindowRead.h"
+#include "../LogWindow.h"
+
+// The 13T: board.toml, 调研/storage-27.md.
+constexpr uint64_t kFirst=107409152, kLast=124186367, kPartition=kLast-kFirst+1, kLunLast=kLast+6;
+constexpr uint64_t kBaseA=10240*256, kBaseB=27648*256, kReserve=1024*256;
+static_assert(kPartition*4096==68719476736ULL);
+static_assert(kFirst+kBaseA==110030592 && kFirst+kBaseB==114487040);
+
+static void put32(uint8_t *p,uint32_t v) { for(unsigned i=0;i<4;++i)p[i]=uint8_t(v>>(i*8)); }
+static void put64(uint8_t *p,uint64_t v) { for(unsigned i=0;i<8;++i)p[i]=uint8_t(v>>(i*8)); }
+
+static void gpt()
+{
+  auto &entries=lun[2]; entries.fill(0);
+  entries[0]=1; entries[16]=2; put64(entries.data()+32,kFirst); put64(entries.data()+40,kLast);
+  for(unsigned i=0;i<6;++i) entries[56+2*i]="unixnu"[i];
+  for(uint32_t i=3;i<6;++i) lun[i].fill(0);
+  std::array<uint8_t,16384> all{}; memcpy(all.data(),entries.data(),4096);
+  auto &header=lun[1]; header.fill(0);
+  memcpy(header.data(),"EFI PART",8); put32(header.data()+8,0x10000); put32(header.data()+12,92);
+  put64(header.data()+24,1); put64(header.data()+32,kLunLast); put64(header.data()+40,6); put64(header.data()+48,kLast);
+  put64(header.data()+72,2); put32(header.data()+80,128); put32(header.data()+84,128);
+  put32(header.data()+88,rootCrc32(all.data(),128*128));
+  put32(header.data()+16,rootCrc32(header.data(),92,true));
+}
+
+struct Item { const char *name; uint64_t offset,size; uint32_t block,flags; };
+static void manifest(uint64_t lba,uint32_t version,uint64_t imageBytes,std::initializer_list<Item> items)
+{
+  auto &m=lun[lba]; m.fill(0);
+  memcpy(m.data(),"SHNGROOT",8); put32(m.data()+8,version); put32(m.data()+12,uint32_t(items.size())); put64(m.data()+16,imageBytes);
+  unsigned index=0;
+  for(const Item &item: items) {
+    uint8_t *e=m.data()+24+128*index++;
+    strcpy(reinterpret_cast<char *>(e),item.name);
+    put64(e+32,item.offset); put64(e+40,item.size); put32(e+48,item.block); put32(e+52,item.flags);
+    memset(e+56,int(index),32);
+  }
+  SHA256(m.data(),4064,m.data()+4064);
+}
+
+static bool parse(RootLayout &layout,uint64_t base,const char **why=nullptr)
+{
+  const char *reason="";
+  readLbas.clear(); readBlocks.clear();
+  const bool result=findRootLayout(&layout,&reason,"unixnu",kLunLast,base);
+  if(why)*why=reason;
+  return result;
+}
+
+constexpr uint64_t kMiB=1024*1024;
+static const uint64_t kImage17=9382658048, kImage27=16*1024*kMiB;
+
+// The 17 image at the partition's start and two 27 images: each base sees its own and nothing of the others.
+static void sideBySide()
+{
+  lun.clear(); gpt();
+  manifest(kFirst,1,kImage17,{{"OS",kMiB,6077580800,512,1},{"SystemOS",5798*kMiB,3150*kMiB,512,1}});
+  manifest(kFirst+kBaseA,1,kImage27,{{"OS",kMiB,10*1024*kMiB,512,1},{"SystemOS",11*1024*kMiB,3*1024*kMiB,512,1}});
+  manifest(kFirst+kBaseB,1,kImage27,{{"OS",2*kMiB,10*1024*kMiB,512,1},{"SystemOS",11*1024*kMiB,4*1024*kMiB,512,1}});
+  RootLayout layout;
+  assert(parse(layout,0) && !layout.manifestStatus && !layout.rootBase && layout.imageBytes==kImage17 && layout.windows==2 && !layout.objects);
+  assert(rootImageFirst(layout)==kFirst && readLbas.back()==kFirst);
+  assert(rootAbsolute(layout,layout.window[0])==kFirst*4096+kMiB);
+  assert(rootAbsolute(layout,layout.window[1])==kFirst*4096+5798*kMiB);
+  assert(parse(layout,kBaseA) && !layout.manifestStatus && layout.rootBase==kBaseA && layout.imageBytes==kImage27 && layout.windows==2);
+  assert(rootImageFirst(layout)==110030592 && readLbas.back()==110030592);
+  assert(rootAbsolute(layout,layout.window[0])==110030592*4096ULL+kMiB && layout.window[0].size==10*1024*kMiB);
+  assert(rootAbsolute(layout,layout.window[0])/4096==110030592+256);
+  assert(ufsWindowGeometry(rootAbsolute(layout,layout.window[1]),layout.window[1].size));
+  assert(parse(layout,kBaseB) && !layout.manifestStatus && layout.rootBase==kBaseB && layout.window[1].size==4*1024*kMiB);
+  assert(rootImageFirst(layout)==114487040 && readLbas.back()==114487040);
+  assert(rootAbsolute(layout,layout.window[0])==114487040*4096ULL+2*kMiB);
+}
+
+// A base with no image behind it is no image: status 1, nothing published, and no fallback to what sits at the partition's start.
+static void noFallback()
+{
+  lun.clear(); gpt();
+  manifest(kFirst,1,kImage17,{{"OS",kMiB,6077580800,512,1},{"SystemOS",5798*kMiB,3150*kMiB,512,1}});
+  RootLayout layout; const char *why=nullptr;
+  assert(parse(layout,kBaseA) && layout.manifestStatus==1 && !layout.windows && !layout.imageBytes);
+  for(uint64_t lba: readLbas) assert(lba!=kFirst);
+  assert(parse(layout,kPartition-1) && layout.manifestStatus==1 && readLbas.back()==kLast);
+  for(const uint64_t base: {kPartition,kPartition+1,uint64_t(UINT32_MAX),UINT64_MAX,UINT64_MAX-kFirst}) {
+    assert(!parse(layout,base,&why) && !strcmp(why,"root base outside the partition"));
+    for(uint64_t lba: readLbas) assert(lba<kFirst);                                             // nothing inside the partition was read
+  }
+  failAt=kFirst+kBaseA;
+  assert(!parse(layout,kBaseA,&why) && !strcmp(why,"root partition first block read"));
+  failAt=UINT64_MAX;
+}
+
+// The manifest is bounded by what the partition holds from the base on, not by the partition.
+static void imageBounds()
+{
+  RootLayout layout;
+  const uint64_t room=(kPartition-kBaseA)*4096;
+  lun.clear(); gpt();
+  const auto image=[&](uint64_t bytes) { manifest(kFirst+kBaseA,1,bytes,{{"OS",kMiB,4096,512,1},{"SystemOS",2*kMiB,4096,512,1}}); };
+  image(room); assert(parse(layout,kBaseA) && !layout.manifestStatus);
+  image(room+4096); assert(parse(layout,kBaseA) && layout.manifestStatus==4 && !layout.windows);
+  manifest(kFirst,1,room+4096,{{"OS",kMiB,4096,512,1},{"SystemOS",2*kMiB,4096,512,1}});
+  assert(parse(layout,0) && !layout.manifestStatus);                                            // the same image fits without a base
+  manifest(kFirst,1,kPartition*4096,{{"OS",kMiB,4096,512,1},{"SystemOS",2*kMiB,4096,512,1}});
+  assert(parse(layout,0) && !layout.manifestStatus);
+  manifest(kFirst,1,kPartition*4096+4096,{{"OS",kMiB,4096,512,1},{"SystemOS",2*kMiB,4096,512,1}});
+  assert(parse(layout,0) && layout.manifestStatus==4);
+  // The last window ends at the last block of the partition, and a read of it stays inside.
+  const uint64_t size=room-kMiB;
+  manifest(kFirst+kBaseA,1,room,{{"OS",kMiB,size,512,1}});
+  assert(parse(layout,kBaseA) && !layout.manifestStatus);
+  assert((rootAbsolute(layout,layout.window[0])+layout.window[0].size)/4096==kLast+1);
+}
+
+static void version2()
+{
+  RootLayout layout;
+  const uint64_t table=(3*1024*kMiB/4096)*32, table2=table+4096+100;
+  const auto v2=[&](uint64_t lba) {
+    manifest(lba,2,kImage27,{{"OS",kMiB,4*1024*kMiB,512,1},{"SystemOS",5*1024*kMiB,3*1024*kMiB,512,1},
+                             {"OS.vroot",9*1024*kMiB,table,4096,3},{"SystemOS.vroot",10*1024*kMiB,table2,4096,3}});
+  };
+  for(const uint64_t base: {uint64_t(0),kBaseA,kBaseB}) {
+    lun.clear(); gpt(); v2(kFirst+base);
+    assert(parse(layout,base) && !layout.manifestStatus && layout.windows==2 && layout.objects==2);
+    assert(!strcmp(layout.window[1].name,"SystemOS") && !strcmp(layout.object[0].name,"OS.vroot") && !strcmp(layout.object[1].name,"SystemOS.vroot"));
+    assert(layout.object[1].size==table2 && layout.object[1].sha256[0]==4);
+    recordRootObjects(layout);
+    assert(gRootObjects==2 && gRootObjectBase==(kFirst+base)*4096);
+    // The object's bytes, across chunks, through the base; a table that does not end on a block boundary keeps only its own bytes.
+    const uint64_t lba=kFirst+base+10*1024*256;
+    std::vector<uint8_t> expected(table2),got(table2+1,0x5c);
+    for(uint64_t i=0;i<table2;++i) expected[i]=uint8_t(i*131+(i>>12));
+    for(uint64_t at=0;at<table2;at+=4096) {
+      auto &block=lun[lba+at/4096]; block.fill(0xee);
+      memcpy(block.data(),expected.data()+at,table2-at<4096?table2-at:4096);
+    }
+    readLbas.clear(); readBlocks.clear();
+    assert(readPolicyTable("SystemOS",got.data(),table2));
+    assert(!memcmp(got.data(),expected.data(),table2) && got[table2]==0x5c);
+    assert(readLbas.front()==lba);
+    for(size_t i=1;i<readLbas.size();++i) assert(readLbas[i]==readLbas[i-1]+readBlocks[i-1]);
+    assert(readLbas.size()>1);
+    // Wrong size, no such object, a name that does not fit, a failed read: refused.
+    assert(!readPolicyTable("SystemOS",got.data(),table2-1));
+    assert(!readPolicyTable("AppOS",got.data(),table2));
+    assert(!readPolicyTable("0123456789012345678901234567890",got.data(),table2));
+    failAt=lba+(table2-1)/4096;
+    assert(!readPolicyTable("SystemOS",got.data(),table2));
+    failAt=UINT64_MAX;
+  }
+  const auto refused=[&](uint32_t status,std::initializer_list<Item> items,uint32_t version=2) {
+    lun.clear(); gpt(); manifest(kFirst+kBaseA,version,kImage27,items);
+    assert(parse(layout,kBaseA) && layout.manifestStatus==status && !layout.windows && !layout.objects);
+  };
+  constexpr uint64_t G=1024*kMiB;
+  refused(2,{{"a",G,512,512,1},{"b",2*G,512,512,1},{"c",3*G,512,512,1},{"d",4*G,512,512,1},{"e",5*G,512,512,1}},1);   // 5 in version 1
+  refused(7,{{"a",G,512,512,1},{"o",2*G,4096,4096,3}},1);                                      // version 1 has no objects
+  refused(7,{{"o",G,4096,4096,3}});                                                            // nothing to publish
+  refused(7,{{"a",G,512,512,1},{"o",2*G,4096,4096,1}});                                        // neither a window nor an object
+  refused(7,{{"a",G,512,512,1},{"b",2*G,512,512,1},{"c",3*G,512,512,1},{"d",4*G,512,512,1},{"e",5*G,512,512,1}});
+  refused(7,{{"a",G,512,512,1},{"o",2*G,4096,4096,3},{"p",3*G,4096,4096,3},{"q",4*G,4096,4096,3},{"r",5*G,4096,4096,3},{"s",6*G,4096,4096,3}});
+  refused(4,{{"a",G,513,512,1}});                                                              // a window keeps its sector size
+  refused(4,{{"a",G,512,512,1},{"o",G+1,4096,4096,3}});
+  refused(5,{{"a",G,512,512,1},{"a",2*G,4096,4096,3}});                                        // names are one namespace
+  refused(6,{{"a",G,4096,512,1},{"o",G,4096,4096,3}});                                         // so is the space
+  refused(6,{{"o",G,4097,4096,3},{"a",G+4096,4096,512,1}});                                    // an object's last block counts whole
+  lun.clear(); gpt(); manifest(kFirst+kBaseA,2,kImage27,{{"o",G,4097,4096,3},{"a",G+8192,4096,512,1}});
+  assert(parse(layout,kBaseA) && !layout.manifestStatus && layout.objects==1 && layout.windows==1);
+}
+
+// Where the log and the store go does not depend on the base; whether they may does: what lies below the image counts as taken.
+static void overlaps()
+{
+  const uint64_t blocks27=kImage27/4096;
+  for(const uint64_t base: {uint64_t(0),kBaseA,kBaseB}) {
+    // Log: the edge of the guard, in blocks of image, from both sides.
+    const uint64_t edge=kPartition-kReserve-base-1024;
+    UfsLogPlan plan=ufsLogPlan("unixnu",kFirst,kLast,edge*4096,kReserve,base);
+    assert(!plan.refusal && plan.logFirst==kLast+1-kLogReserveBlocks && plan.exportFirst==plan.logFirst-kExportBlocks);
+    assert(!strcmp(ufsLogPlan("unixnu",kFirst,kLast,edge*4096+1,kReserve,base).refusal,"overlaps the root image"));
+    assert(!ufsLogPlan("unixnu",kFirst,kLast,blocks27*4096,kReserve,base).refusal);
+    // Store: the same edge less its size; its place is fixed by the end of the partition.
+    constexpr uint64_t store=19*1024*256;
+    const uint64_t storeEdge=edge-store;
+    uint64_t first=0;
+    assert(!ufsStorePlan(kFirst,kLast,storeEdge*4096,store,kReserve,base,&first) && first==kLast+1-kReserve-store);
+    first=0;
+    assert(!strcmp(ufsStorePlan(kFirst,kLast,storeEdge*4096+1,store,kReserve,base,&first),"overlaps the root image") && !first);
+    assert(!ufsStorePlan(kFirst,kLast,blocks27*4096,store,kReserve,base,&first));
+  }
+  // An image that clears the log at base 0 runs into it at 10240 MiB; the 13T's 9 GiB image does not.
+  const uint64_t edge0=(kPartition-kReserve-1024)*4096;
+  assert(!ufsLogPlan("unixnu",kFirst,kLast,edge0,kReserve,0).refusal);
+  assert(ufsLogPlan("unixnu",kFirst,kLast,edge0,kReserve,kBaseA).refusal);
+  assert(!ufsLogPlan("unixnu",kFirst,kLast,0x22F400000,kReserve,kBaseA).refusal);
+  uint64_t first=0;
+  assert(!ufsStorePlan(kFirst,kLast,edge0-4096,1,kReserve,0,&first));
+  assert(ufsStorePlan(kFirst,kLast,edge0-4096,1,kReserve,kBaseA,&first));
+  // Base at the very top: the subtraction must not wrap into "plenty of room".
+  for(const uint64_t base: {kPartition-kReserve,kPartition-kReserve+1,kPartition,uint64_t(UINT64_MAX)}) {
+    assert(ufsLogPlan("unixnu",kFirst,kLast,4096,kReserve,base).refusal);
+    assert(ufsStorePlan(kFirst,kLast,4096,4096,kReserve,base,&first));
+  }
+  assert(ufsLogPlan("unixnu",kFirst,kLast,0,kReserve,kPartition-kReserve-1023).refusal);
+  assert(!ufsLogPlan("unixnu",kFirst,kLast,0,kReserve,kPartition-kReserve-1024).refusal);
+  assert(ufsStorePlan(kFirst,kLast,0,4096,kReserve,kPartition-kReserve-4096-1023,&first));
+  assert(!ufsStorePlan(kFirst,kLast,0,4096,kReserve,kPartition-kReserve-4096-1024,&first));
+  // The store's size refusals come first, as they always did.
+  assert(!strcmp(ufsStorePlan(kFirst,kLast,4096,0,kReserve,kBaseA,&first),"size"));
+  assert(!strcmp(ufsStorePlan(kFirst,kLast,4096,kPartition-kReserve+1,kReserve,kBaseA,&first),"size"));
+  assert(!strcmp(ufsStorePlan(kFirst,kLast,4096,1,kPartition,kBaseA,&first),"size"));
+  // Open: a refusal by the base touches nothing.
+  uint8_t block[4096]; uint64_t logFirst=0; unsigned reads=0,opens=0;
+  auto read=[&](uint64_t,uint8_t *to) { ++reads; memset(to,0,4096); return true; };
+  auto open=[&](uint64_t,uint64_t) { ++opens; return true; };
+  assert(ufsLogOpenWindow("unixnu",kFirst,kLast,edge0,kReserve,block,read,open,&logFirst,kBaseA) && !reads && !opens && !logFirst);
+  assert(!ufsLogOpenWindow("unixnu",kFirst,kLast,edge0,kReserve,block,read,open,&logFirst) && reads==4 && opens==1 && logFirst==kLast+1-kLogReserveBlocks);
+}
+
+int main()
+{
+  sideBySide();
+  noFallback();
+  imageBounds();
+  version2();
+  overlaps();
+  puts("PASS: root base 0, 10240 and 27648 MiB: manifest, windows, objects, image bounds and the log's and store's overlap edges; version 2 objects");
+}
