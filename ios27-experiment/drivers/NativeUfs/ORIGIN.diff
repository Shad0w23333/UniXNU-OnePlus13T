@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// With root base 0 this copy must do what the iPadOS 17 mainline does: the mainline's RootLayout.h and LogWindow.h, compiled beside this copy's
+// under MAINLINE_DIR, on the same inputs, field by field and read by read. Version 1 only: version 2 is new at every base. Host only.
+#define OPENSSL_SUPPRESS_DEPRECATED
+#include <openssl/sha.h>
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <random>
+#include <vector>
+#include "../RootDiagnostics.h"
+using IOReturn=uint32_t;
+constexpr IOReturn kIOReturnSuccess=0;
+constexpr unsigned kDataMax=131072;
+static UfsRootDiagnostics gRootDiagnostic;
+static uint8_t header[4096],entries[16384],manifest[4096];
+static uint64_t manifestLba;
+static std::vector<std::pair<uint64_t,uint32_t>> reads;
+static uint64_t failLba=UINT64_MAX;
+static IOReturn hostRead4k(uint8_t,uint64_t lba,uint32_t blocks,void *out)
+{
+  reads.push_back({lba,blocks});
+  if(lba==failLba) return 1;
+  memset(out,0,blocks*4096ULL);
+  if(lba==1 && blocks==1) memcpy(out,header,4096);
+  else if(lba>=2 && lba<6) memcpy(out,entries+(lba-2)*4096,(6-lba)*4096>blocks*4096ULL?blocks*4096ULL:(6-lba)*4096);
+  else if(lba==manifestLba && blocks==1) memcpy(out,manifest,4096);
+  return 0;
+}
+#define STRINGIFY2(x) #x
+#define STRINGIFY(x) STRINGIFY2(x)
+namespace mainline {
+#include STRINGIFY(MAINLINE_DIR/RootLayout.h)
+#include STRINGIFY(MAINLINE_DIR/LogWindow.h)
+}
