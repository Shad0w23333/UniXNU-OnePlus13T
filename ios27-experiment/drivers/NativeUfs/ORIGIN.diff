+static void put32(uint8_t *p,uint32_t v) { for(unsigned i=0;i<4;++i)p[i]=uint8_t(v>>(i*8)); }
+static void put64(uint8_t *p,uint64_t v) { for(unsigned i=0;i<8;++i)p[i]=uint8_t(v>>(i*8)); }
+static void checksums()
+{
+  SHA256(manifest,4064,manifest+4064);
+  put32(header+88,port::rootCrc32(entries,128*128));
+  put32(header+16,port::rootCrc32(header,92,true));
+}
+static void fixture()
+{
+  memset(header,0,sizeof(header)); memset(entries,0,sizeof(entries)); memset(manifest,0,sizeof(manifest));
+  memcpy(header,"EFI PART",8); put32(header+8,0x10000); put32(header+12,92);
+  put64(header+24,1); put64(header+32,0x3d0abff); put64(header+40,6); put64(header+48,0x3d0abfa);
+  put64(header+72,2); put32(header+80,128); put32(header+84,128);
+  entries[0]=1; entries[16]=2; put64(entries+32,0x2f3840); put64(entries+40,0x3d0abfa);
+  for(unsigned i=0;i<6;++i) entries[56+2*i]="unixnu"[i];
+  manifestLba=0x2f3840;
+  memcpy(manifest,"SHNGROOT",8); put32(manifest+8,1); put32(manifest+12,2); put64(manifest+16,1ULL<<33);
+  for(unsigned i=0;i<2;++i) {
+    uint8_t *e=manifest+24+i*128; strcpy(reinterpret_cast<char *>(e),i?"SystemOS":"OS");
+    put64(e+32,(1ULL<<20)+(uint64_t(i)<<32)); put64(e+40,1ULL<<30); put32(e+48,512); put32(e+52,1);
+    memset(e+56,0x41+int(i),32);
+  }
+  checksums();
+}
+
+static void sameWindow(const mainline::RootWindow &a,const port::RootWindow &b)
+{
+  assert(!memcmp(a.name,b.name,32) && a.offset==b.offset && a.size==b.size && !memcmp(a.sha256,b.sha256,32));
+}
+
+static unsigned accepted,refusedManifest,refusedGpt;
+static void same(const char *wanted,uint64_t lastLba)
+{
+  static mainline::RootLayout a; static port::RootLayout b;
+  memset(&a,0x55,sizeof(a)); memset(&b,0xaa,sizeof(b));
+  const char *whyA="-",*whyB="-";
+  reads.clear(); const bool ra=mainline::findRootLayout(&a,&whyA,wanted,lastLba); const auto readsA=reads;
+  reads.clear(); const bool rb=port::findRootLayout(&b,&whyB,wanted,lastLba); const auto readsB=reads;
+  assert(ra==rb && readsA==readsB && !strcmp(whyA,whyB));
+  assert(a.userdataFirst==b.userdataFirst && a.userdataLast==b.userdataLast && a.imageBytes==b.imageBytes && a.gptEntriesLba==b.gptEntriesLba);
+  assert(a.gptHeaderCrc==b.gptHeaderCrc && a.gptEntriesCrc==b.gptEntriesCrc && a.gptEntryCount==b.gptEntryCount);
+  assert(a.windows==b.windows && a.manifestStatus==b.manifestStatus && a.magic0==b.magic0 && a.magic1==b.magic1);
+  assert(a.ext4Magic==b.ext4Magic && a.ext4Blocks==b.ext4Blocks && !b.rootBase && !b.objects);
+  for(uint32_t i=0;i<a.windows;++i) {
+    sameWindow(a.window[i],b.window[i]);
+    assert(a.userdataFirst*4096ULL+a.window[i].offset==port::rootAbsolute(b,b.window[i]));
+  }
+  if(!ra) ++refusedGpt; else if(a.manifestStatus) ++refusedManifest; else ++accepted;
+}
+
+// native_ufs_store_open's checks as the mainline writes them inline.
+static const char *mainlineStore(uint64_t firstLba,uint64_t lastLba,uint64_t imageBytes,uint64_t blocks,uint64_t reserve,uint64_t *out)
+{
+  uint64_t partition=lastLba-firstLba+1;
+  uint64_t imageBlocks=(imageBytes+4095)/4096;
+  if(!blocks || reserve>=partition || blocks>partition-reserve) return "size";
+  if(partition-blocks-reserve<imageBlocks+1024) return "overlaps the root image";
+  *out=lastLba+1-reserve-blocks;
+  return nullptr;
+}
+
+int main()
+{
+  std::mt19937_64 random(0x13717);
+  // The named cases of tests/RootLayout.cpp and the one-off faults around them.
+  fixture(); same("unixnu",UINT32_MAX);
+  fixture(); same("unixnu",0x3d0abff); same("unixnu",0x3d0abfe); same("userdata",UINT32_MAX); same("",UINT32_MAX); same(nullptr,UINT32_MAX);
+  fixture(); failLba=0x2f3840; same("unixnu",UINT32_MAX); failLba=1; same("unixnu",UINT32_MAX); failLba=2; same("unixnu",UINT32_MAX); failLba=UINT64_MAX;
+  // Mutations of everything the parser reads, with the checksums made right again, so that they reach the checks behind them.
+  for(unsigned i=0;i<200000;++i) {
+    fixture();
+    const unsigned changes=1+unsigned(random()%3);
+    for(unsigned c=0;c<changes;++c) {
+      const uint64_t value=random();
+      switch(random()%8) {
+        case 0: manifest[random()%(24+128*4)]^=uint8_t(value|1); break;
+        case 1: { uint8_t *e=manifest+24+128*(random()%4); put64(e+32,value&0x3fffff000ULL); break; }
+        case 2: { uint8_t *e=manifest+24+128*(random()%4); put64(e+40,value&0x3ffffffffULL); break; }
+        case 3: { uint8_t *e=manifest+24+128*(random()%4); put32(e+48,(value&1)?512:4096); put32(e+52,(value&2)?1:3); break; }
+        case 4: put32(manifest+12,uint32_t(value%7)); break;
+        case 5: put64(manifest+16,value&0x7ffffffffULL); break;
+        case 6: header[random()%92]^=uint8_t(value|1); break;
+        default: entries[random()%256]^=uint8_t(value|1); break;
+      }
+    }
+    if(random()%8) put32(manifest+8,1);                                                          // mostly version 1, some any other but 2
+    if(port::le32(manifest+8)==2) put32(manifest+8,3);
+    if(random()%32) checksums();
+    manifestLba=port::le64(entries+32);
+    same("unixnu",UINT32_MAX);
+  }
+  assert(accepted>1000 && refusedManifest>1000 && refusedGpt>1000);
+  // A partition holding no image at all: the same as the mainline, block contents and all.
+  fixture(); memset(manifest,0,sizeof(manifest)); manifest[1080]=0x53; manifest[1081]=0xef; put32(manifest+1028,1234); same("unixnu",UINT32_MAX);
+  // The plans, on boundaries and at random.
+  const auto pick=[&](uint64_t around) { const uint64_t spread=uint64_t(random()%4097)-2048; return (random()%4)?around+spread:random()>>(random()%64); };
+  unsigned plans=0;
+  for(unsigned i=0;i<2000000;++i) {
+    uint64_t first=pick(107409152),last=pick(124186367),partition=last-first+1,reserve=pick(262144);
+    if(random()%2) reserve=pick(partition);
+    uint64_t image=pick((partition-reserve-1024)*4096),blocks=pick(4980736);
+    if(random()%2) blocks=pick(partition-reserve-(image+4095)/4096-1024);
+    const char *name=(random()%16)?"unixnu":"userdata";
+    const auto a=mainline::ufsLogPlan(name,first,last,image,reserve);
+    const auto b=port::ufsLogPlan(name,first,last,image,reserve);
+    assert(!a.refusal==!b.refusal && (!a.refusal || !strcmp(a.refusal,b.refusal)) && a.logFirst==b.logFirst && a.exportFirst==b.exportFirst);
+    if(!a.refusal) ++plans;
+    uint64_t storeA=0,storeB=0;
+    const char *ra=mainlineStore(first,last,image,blocks,reserve,&storeA),*rb=port::ufsStorePlan(first,last,image,blocks,reserve,0,&storeB);
+    assert(!ra==!rb && (!ra || !strcmp(ra,rb)) && storeA==storeB);
+  }
+  assert(plans>1000);
+  printf("PASS: base 0 is the mainline: %u layouts accepted, %u manifests and %u GPTs refused alike, same reads; log and store plans alike\n",accepted,refusedManifest,refusedGpt);
+}
