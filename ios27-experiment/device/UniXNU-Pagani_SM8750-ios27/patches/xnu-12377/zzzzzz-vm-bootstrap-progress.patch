diff --git a/osfmk/vm/vm_resident.c b/osfmk/vm/vm_resident.c
index 8bebebb..87a7392 100644
--- a/osfmk/vm/vm_resident.c
+++ b/osfmk/vm/vm_resident.c
@@ -1,3 +1,4 @@
+#include <kern/boot_progress.h>
 /*
  * Copyright (c) 2000-2020 Apple Inc. All rights reserved.
  *
@@ -2246,6 +2247,7 @@ vm_page_bootstrap(
 	(void)pmap_free_pages();
 
 	kernel_startup_initialize_upto(STARTUP_SUB_PMAP_STEAL);
+	boot_progress_stage("VM hash sizing");
 
 	/*
 	 *	Allocate (and initialize) the virtual-to-physical
@@ -2257,6 +2259,9 @@ vm_page_bootstrap(
 	 *	than the number of physical pages in the system.
 	 */
 
+#if defined(XNU_BOOT_PROGRESS) && XNU_BOOT_PROGRESS
+	kprintf("VM available pages=%u\n", pmap_free_pages());
+#endif
 	vm_page_bucket_count      = 1u << fls(pmap_free_pages());
 	vm_page_hash_mask         = vm_page_bucket_count - 1;
 	vm_page_bucket_lock_count = (vm_page_bucket_count + BUCKETS_PER_LOCK - 1) / BUCKETS_PER_LOCK;
@@ -2310,11 +2315,13 @@ vm_page_bootstrap(
 #endif /* VM_PAGE_FAKE_BUCKETS */
