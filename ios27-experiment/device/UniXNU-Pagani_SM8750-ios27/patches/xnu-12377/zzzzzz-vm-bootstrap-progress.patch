zzzzzz-vm-bootstrap-progress.patch（xnu-12377 版）

来源：本项目 UniXNU-Pagani_SM8750-gpu/patches/xnu/zzzzzz-vm-bootstrap-progress.patch（10063）。
处理：手工移植，19 块里 10 块按 12377 重写：
- vm_resident.c 大改：hash 大小改成一行 1u << fls(pmap_free_pages())，原来的 npages 局部变量没了；
  pmap_startup 的释放循环用 vm_free_page_lock 包住，“VM frame release done”放到解锁之后。
- pmap.c 的 pmap_tt_allocate 多了 alloc_flags。
所有进度点保持原名，日志解析不用改。
注意：pmap.o、vm_resident.o、vm_init.o 不在 build-xnu-4k-baseline.sh 第二遍强制重编的对象表里（104-108 行），
跟 10063 一样，这些点是否生效取决于对象是否带 XNU_BOOT_PROGRESS=1 编译。27 上要看全部进度应把它们加入表中。

diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 9760c9c..98a5fb4 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -3678,6 +3678,11 @@ pmap_tt_allocate(
 		/*
 		 *  Allocate a VM page for the level x page table entries.
 		 */
+#if defined(XNU_BOOT_PROGRESS) && XNU_BOOT_PROGRESS
+		if (!pmap_initialized) {
+			kprintf("VM tt page allocation: level=%u\n", level);
+		}
+#endif
 		while (pmap_pages_alloc_zeroed(&pa, PAGE_SIZE, alloc_flags) != KERN_SUCCESS) {
 			if (options & PMAP_OPTIONS_NOWAIT) {
 				return KERN_RESOURCE_SHORTAGE;
@@ -3685,6 +3690,11 @@ pmap_tt_allocate(
 			VM_PAGE_WAIT();
 		}
 
+#if defined(XNU_BOOT_PROGRESS) && XNU_BOOT_PROGRESS
+		if (!pmap_initialized) {
+			kprintf("VM tt page allocated: pa=%llx; allocating PTD\n", (unsigned long long)pa);
+		}
+#endif
 		/* Allocate a new Page Table Descriptor for the newly allocated page table. */
 		while ((ptdp = ptd_alloc(pmap)) == NULL) {
 			if (options & PMAP_OPTIONS_NOWAIT) {
@@ -3695,6 +3705,11 @@ pmap_tt_allocate(
 			VM_PAGE_WAIT();
 		}
 
+#if defined(XNU_BOOT_PROGRESS) && XNU_BOOT_PROGRESS
+		if (!pmap_initialized) {
+			kprintf("VM tt PTD allocated\n");
+		}
+#endif
 		if (level < pt_attr_leaf_level(pmap_get_pt_attr(pmap))) {
 			OSAddAtomic64(1, &alloc_ttepages_count);
 			OSAddAtomic(1, (pmap == kernel_pmap ? &inuse_kernel_ttepages_count : &inuse_user_ttepages_count));
@@ -6299,7 +6314,18 @@ pmap_enter_options_internal(
 		/* Must unlock to expand the pmap. */
 		pmap_unlock(pmap, lock_mode);
 
+#if defined(XNU_BOOT_PROGRESS) && XNU_BOOT_PROGRESS
+		if (!pmap_initialized) {
+			kprintf("VM expand: va=%llx pa=%llx\n",
+			    (unsigned long long)v, (unsigned long long)pa);
+		}
+#endif
 		kr = pmap_expand(pmap, v, options, pt_attr_leaf_level(pt_attr));
+#if defined(XNU_BOOT_PROGRESS) && XNU_BOOT_PROGRESS
+		if (!pmap_initialized) {
+			kprintf("VM expand returned: kr=%d\n", kr);
+		}
+#endif
 
 		if (kr != KERN_SUCCESS) {
 			return kr;
