phone-app-exec-count.patch（xnu-12377 版）

来源：本项目 UniXNU-Pagani_SM8750-gpu/patches/xnu/phone-app-exec-count.patch（10063）。
处理：保留，无模糊，已核对第二块仍在 exec_activate_image 的成功分支里，excpath 仍有效。
作用：统计 App 和扩展的 exec 次数，给 PaganiArmCpu 的启动加速用。

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 283eaed..227f9ff 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -348,6 +348,12 @@ __attribute__((noinline)) int __EXEC_WAITING_ON_TASKGATED_CODE_SIGNATURE_UPCALL_
 extern vm_map_t bsd_pageable_map;
 extern const struct fileops vnops;
 extern int nextpidversion;
+/*
+ * phone-app-exec-count.patch. One more at every exec of an app or extension bundle, what the CPU governor's launch boost starts on
+ * (PaganiArmCpu CpuFreqGovernor.h). launchd spawns apps and extensions itself and daemons through xpcproxy, and both come here, so the
+ * path is what tells them apart.
+ */
+int pagani_app_execs = 0;
 
 
 #define USER_ADDR_ALIGN(addr, val) \
@@ -3636,6 +3642,13 @@ encapsulated_binary:
 	if (error == -1) {
 		error = ENOEXEC;
 	} else if (error == 0) {
+		/*
+		 * phone-app-exec-count.patch. Here and no later: the end of this function frees the strings excpath points into, with
+		 * imgp->ip_strings set to NULL. No ".app" alone: it is in every com.apple.x daemon's name.
+		 */
+		if (strnstr(excpath, ".app/", MAXPATHLEN) != NULL || strnstr(excpath, ".appex/", MAXPATHLEN) != NULL) {
+			OSIncrementAtomic(&pagani_app_execs);
+		}
 		if (imgp->ip_flags & IMGPF_INTERPRET && ndp->ni_vp) {
 			AUDIT_ARG(vnpath, ndp->ni_vp, ARG_VNODE2);
 		}
