@@ -3925,6 +3985,9 @@ VNOP_GETATTR(vnode_t vp, struct vnode_attr * vap, vfs_context_t ctx)
 
 	_err = (*vp->v_op[vnop_getattr_desc.vdesc_offset])(&a);
