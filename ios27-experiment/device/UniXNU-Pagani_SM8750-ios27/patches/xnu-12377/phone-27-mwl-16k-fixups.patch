+	/*
+	 * 16 KiB fixup pages on a 4 KiB kernel: assemble the whole fixup page in a scratch
+	 * buffer, apply the chain once, then copy out the requested 4 KiB part.
+	 */
+	if (mwli_page_size > PAGE_SIZE) {
