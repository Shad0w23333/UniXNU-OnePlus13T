+		fixup_alloc = kalloc_data(2 * (vm_size_t)mwli_page_size, Z_WAITOK);
+		if (fixup_alloc == NULL) {
+			retval = KERN_RESOURCE_SHORTAGE;
+			goto done;
+		}
+		fixup_buffer = (void *)(((uintptr_t)fixup_alloc + mwli_page_size - 1) & ~((uintptr_t)mwli_page_size - 1));
+	}
+
