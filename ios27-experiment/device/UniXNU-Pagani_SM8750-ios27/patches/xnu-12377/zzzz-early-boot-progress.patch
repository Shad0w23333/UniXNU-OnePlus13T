+#else
 	b	EXT(start_first_cpu)
+#endif
 
 
 /*
@@ -481,8 +485,13 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 	// Set low reset vector before attempting any loads
+#if XNU_EARLY_BOOT_PROGRESS
+	adrp x0, EXT(early_boot_progress_vectors)@page
+	add x0, x0, EXT(early_boot_progress_vectors)@pageoff
+#else
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
+#endif
 	MSR_VBAR_EL1_X0
 
 
@@ -632,6 +641,24 @@ Lbootstrap_tables_exhausted:
 	// the early debugger rather than corrupting memory or forging a map.
 	b Lbootstrap_tables_exhausted
 Lbootstrap_tables_ready:
+#if XNU_EARLY_BOOT_PROGRESS
+	// start_first_cpu has selected virtual stacks before enabling the MMU.
+	mov x27, sp
+	mov x28, lr
+	adrp x9, EXT(early_boot_progress_stack)@page
+	add x9, x9, EXT(early_boot_progress_stack)@pageoff
+	add x9, x9, #4096
+	mov sp, x9
+	mov x0, x25
+	add x1, x2, #PGBYTES
+	add x2, x25, #(BOOTSTRAP_TABLE_BYTES >> 12), lsl #12
+	bl EXT(early_boot_progress_map)
+	cbnz x0, 1f
+	brk #0xe01
+1:
+	mov lr, x28
+	mov sp, x27
+#endif
 	/* Ensure TTEs are visible */
 	dsb		ish
 
@@ -748,10 +775,17 @@ common_start:
 
 	cbnz		x21, 1f
 #endif /* __ARM_KERNEL_PROTECT__ */
+#if XNU_EARLY_BOOT_PROGRESS
+	adrp x0, EXT(early_boot_progress_vectors)@page
+	add x0, x0, EXT(early_boot_progress_vectors)@pageoff
+#else
 	adrp	x0, EXT(ExceptionVectorsBase)@page			// Load exception vectors base address
 	add		x0, x0, EXT(ExceptionVectorsBase)@pageoff
+#endif
+#if !XNU_EARLY_BOOT_PROGRESS
 	add		x0, x0, x22									// Convert exception vector address to KVA
 	sub		x0, x0, x23
+#endif
 1:
 	MSR_VBAR_EL1_X0
 
@@ -770,6 +804,28 @@ common_start:
 	bne		.
 #endif /* !VMAPPLE */
 
+#if XNU_EARLY_BOOT_PROGRESS
+	cbnz x21, Lsecondary_progress_vectors
+	adrp x0, EXT(early_boot_progress_vectors)@page
+	add x0, x0, EXT(early_boot_progress_vectors)@pageoff
+	add x0, x0, x22
+	sub x0, x0, x23
+	msr VBAR_EL1, x0
+	isb
+	mov x28, lr
+	bl EXT(early_boot_progress_mmu_on)
+	mov lr, x28
+	b Lprogress_vectors_ready
+Lsecondary_progress_vectors:
+	adrp x0, EXT(ExceptionVectorsBase)@page
+	add x0, x0, EXT(ExceptionVectorsBase)@pageoff
+	add x0, x0, x22
+	sub x0, x0, x23
+	msr VBAR_EL1, x0
+	isb
+Lprogress_vectors_ready:
+#endif
+
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
