@@ -357,6 +358,7 @@ arm_init(
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+	early_boot_progress_arm_init();
 	arm_slide_rebase_and_sign_image();
 
 	arm_static_if_init(args);
@@ -582,7 +584,9 @@ arm_init(
 	pmap_first_pnum = (ppnum_t)atop(gDramBase);
 
 	boot_progress_stage("arm_vm_init enter");
+	early_boot_progress_suspend();
 	arm_vm_init(xmaxmem, args);
+	early_boot_progress_vm_ready();
 	boot_progress_stage("arm_vm_init returned");
 
 	if (debug_boot_arg) {
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index d6fff49..29e3ff2 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1,3 +1,4 @@
+#include <kern/early_boot_progress.h>
 #include <kern/boot_progress.h>
 /*
  * Copyright (c) 2012-2023 Apple Inc. All rights reserved.
@@ -671,6 +672,7 @@ sleh_synchronous_sp1(arm_context_t *context, uint64_t esr, vm_offset_t far __unu
 {
 	esr_exception_class_t  class = ESR_EC(esr);
 	arm_saved_state_t    * state = &context->ss;
+	boot_progress_kernel_exception(esr, get_saved_state_pc(state), far);
 
 	switch (class) {
 	case ESR_EC_UNCATEGORIZED:
@@ -2567,6 +2569,7 @@ handle_kernel_abort(arm_saved_state_t *state, uint64_t esr, vm_offset_t fault_ad
 			}
 			return;
 		} else {
+			boot_progress_kernel_exception(esr, get_saved_state_pc(state), fault_addr);
 			panic_with_thread_kernel_state("Unexpected page fault under dtrace_probe", state);
 		}
 	}
@@ -2645,9 +2648,11 @@ handle_kernel_abort(arm_saved_state_t *state, uint64_t esr, vm_offset_t fault_ad
 		 * when running with KTRR.
 		 */
 		if (__improbable(fault_addr >= physmap_base) && (fault_addr < physmap_end)) {
+			boot_progress_kernel_exception(esr, get_saved_state_pc(state), fault_addr);
 			panic_with_thread_kernel_state("Unexpected fault in kernel physical aperture", state);
 		}
 		if (__improbable(fault_addr >= gVirtBase && fault_addr < static_memory_end)) {
+			boot_progress_kernel_exception(esr, get_saved_state_pc(state), fault_addr);
 			panic_with_thread_kernel_state("Unexpected fault in kernel static region", state);
 		}
 
@@ -2724,6 +2729,7 @@ handle_kernel_abort(arm_saved_state_t *state, uint64_t esr, vm_offset_t fault_ad
 			handle_kernel_abort_recover(state, esr, fault_addr, thread, recover);
 			return;
 		}
+		boot_progress_kernel_exception(esr, get_saved_state_pc(state), fault_addr);
 		panic_with_thread_kernel_state("Unaligned kernel data abort.", state);
 	} else if (is_parity_error(fault_code)) {
 #if defined(APPLE_ARM64_ARCH_FAMILY)
@@ -2731,12 +2737,15 @@ handle_kernel_abort(arm_saved_state_t *state, uint64_t esr, vm_offset_t fault_ad
 		 * Platform errors are handled in sleh_sync before interrupts are enabled.
 		 */
 #else
+		boot_progress_kernel_exception(esr, get_saved_state_pc(state), fault_addr);
 		panic_with_thread_kernel_state("Kernel parity error.", state);
 #endif
 	} else {
 		kprintf("Unclassified kernel abort (fault_code=0x%x)\n", fault_code);
 	}
 
+	boot_progress_kernel_exception(esr, get_saved_state_pc(state), fault_addr);
+
 	panic_with_thread_kernel_state("Kernel data abort.", state);
 }
 
