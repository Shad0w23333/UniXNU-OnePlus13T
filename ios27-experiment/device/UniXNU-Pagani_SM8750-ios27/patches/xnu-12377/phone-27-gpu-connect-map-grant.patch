 	return false;
 }
 
+/* The kobject filter grant (osfmk/device/iokit_rpc.c native_kobj_map_grant): the native GPU driver's user client only. */
+extern "C" boolean_t native_adreno_connect_granted(io_object_t obj);
+extern "C" boolean_t
+native_adreno_connect_granted(io_object_t obj)
+{
+	IOUserClient * client = OSDynamicCast(IOUserClient, (OSObject *) obj);
+	return client && 0 == strcmp(client->getMetaClass()->getClassName(), "AGXDeviceUserClient");
+}
