diff --git a/osfmk/device/iokit_rpc.c b/osfmk/device/iokit_rpc.c
index fd3e49e..64bcd3f 100644
--- a/osfmk/device/iokit_rpc.c
+++ b/osfmk/device/iokit_rpc.c
@@ -125,6 +125,25 @@ iokit_lookup_connect_port(ipc_port_t port)
 	return iokit_lookup_io_object(port, IKOT_IOKIT_CONNECT);
 }
 
+/* io_connect_map_memory_into_task (2863) and io_connect_unmap_memory_from_task (2864) on the native GPU driver's user client:
+ * allowed past the sandbox's kobject filter (ipc_kobject_server_internal). Any other routine or object: false. */
+extern boolean_t native_adreno_connect_granted(io_object_t obj);
+boolean_t native_kobj_map_grant(ipc_port_t port, mach_msg_id_t msgh_id);
+boolean_t
+native_kobj_map_grant(ipc_port_t port, mach_msg_id_t msgh_id)
+{
+	if ((msgh_id != 2863 && msgh_id != 2864) || !IP_VALID(port) || ip_type(port) != IKOT_IOKIT_CONNECT) {
+		return FALSE;
+	}
+	io_object_t obj = iokit_lookup_connect_port(port);
+	if (!obj) {
+		return FALSE;
+	}
+	boolean_t granted = native_adreno_connect_granted(obj);
+	iokit_remove_connect_reference(obj);
+	return granted;
+}
