zzzz-boot-progress-panic-output.patch（xnu-12377 版）

来源：本项目 UniXNU-Pagani_SM8750-gpu/patches/xnu/zzzz-boot-progress-panic-output.patch（10063）。
处理：手工移植。3 块里 2 块打不上：12377 的 consdebug_putc 和 consdebug_putc_unbuffered 多了
PE_kputc 判空和 SPTM 串口分支。判断里照旧加 !boot_progress_active()；非 SPTM 内核的 sptm_serial_putc 是空宏，
所以 BootProgress 占屏时什么都不输出，与 10063 行为相同。
作用：BootProgress 接管屏幕后，panic 文字不再走 PE_kputc 写到屏幕上打架。上机看 panic 必须有。

diff --git a/osfmk/kern/printf.c b/osfmk/kern/printf.c
index 2fc6931..5138aa0 100644
--- a/osfmk/kern/printf.c
+++ b/osfmk/kern/printf.c
@@ -1,3 +1,4 @@
+#include <kern/boot_progress.h>
 /*
  * Copyright (c) 2000-2020 Apple Inc. All rights reserved.
  *
@@ -930,7 +931,7 @@ consdebug_putc(char c)
 	debug_putc(c);
 
 	/* Ignore `disable_serial_output` for early panic serial output from `sptm_serial_putc()`. */
-	if (!console_is_serial() && !disable_serial_output && (PE_kputc != NULL)) {
+	if (!console_is_serial() && !disable_serial_output && !boot_progress_active() && (PE_kputc != NULL)) {
 		PE_kputc(c);
 	} else if (!console_is_serial() && (PE_kputc == NULL)) {
 		/* Use SPTM's serial interface for early serial output. */
@@ -946,7 +947,7 @@ consdebug_putc_unbuffered(char c)
 	debug_putc(c);
 
 	/* Ignore `disable_serial_output` for early panic serial output from `sptm_serial_putc()`. */
-	if (!console_is_serial() && !disable_serial_output && (PE_kputc != NULL)) {
+	if (!console_is_serial() && !disable_serial_output && !boot_progress_active() && (PE_kputc != NULL)) {
 		PE_kputc(c);
 	} else if (!console_is_serial() && (PE_kputc == NULL)) {
 		/* Use SPTM's serial interface for early serial output. */
