+	return 1;
+}
+
+/* The next waiting line of a slot taken over; 0 when none is left. A second takeover before the summary keeps only the newer one. */
+static inline int
+pagani_kbt_take_final(struct pagani_kbt *t, char *line, size_t size)
+{
+	if (!t->final_lines) {
+		return 0;
+	}
+	const char *from = t->final[t->final_lines == 2 ? 1 : 0];
+	(void)pagani_kbt_put(line, size, 0, from);
+	t->final_lines--;
+	return 1;
+}
+
+/* The stall probe's pair of a kind (StallProbe.h: 0 dn, 1 up, 2 in), *end when it ends one; -1: none. */
+static inline int
+pagani_kbt_stall_group(int kind, int *end)
+{
+	*end = kind == PAGANI_KBT_DN_DONE || kind == PAGANI_KBT_UP_DONE || kind == PAGANI_KBT_IN_DONE;
+	switch (kind) {
+	case PAGANI_KBT_DN: case PAGANI_KBT_DN_DONE: return 0;
+	case PAGANI_KBT_UP: case PAGANI_KBT_UP_DONE: return 1;
+	case PAGANI_KBT_IN: case PAGANI_KBT_IN_DONE: return 2;
+	default: return -1;
+	}
+}
