phone-system-apps-view.patch（xnu-12377 版）

来源：本项目 UniXNU-Pagani_SM8750-gpu/patches/xnu/phone-system-apps-view.patch（10063）。
处理：手工移植，4 块里 1 块是 overlays 行，跟随 phone-boot-facts 的改动重写，其余无模糊。
作用：pagani-system-apps=1（配合 sheng-staged-apps=1）时删掉迁移哨兵，把 Data 里的系统 App 副本以联合视图挂到 /Applications。
27 上的风险：
- 哨兵路径 MobileCal.app 来自 21H461，27 上名字没核实，只影响 stage 数字。
- sheng 在 24A446 上走另一条路：不复制，直接把只读卷的 staged_system_apps 挂到 /Applications（phone-27-staged-apps-union.patch）。
  两条路二选一，建议 27 先用联合视图，它不占 Data 空间，也不用 20 分钟的迁移。

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index ae3c623..41a50f2 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -9181,6 +9181,11 @@ native_gpu_addon_prepare(proc_t p, user_addr_t scratch)
 /* BootProgress's ramoops trace (U lines), on boards that link it. */
 extern void boot_progress_trace(const char *text) __attribute__((weak_import));
 volatile int native_staged_apps_stage = 0;
+/* The copied apps shown in /Applications (pagani-system-apps, native_system_apps_show below): stage and status as for the addon views,
+ * and the removal of the migration sentinel (0, or errno: ENOENT when the seed had none). */
+volatile int native_system_apps_stage = 0;
+volatile int native_system_apps_status = -1;
+volatile int native_system_apps_sentinel = -1;
 volatile int native_staged_apps_dirs = 0;
 volatile int native_staged_apps_files = 0;
 volatile int native_staged_apps_mib = 0;
@@ -9691,7 +9696,8 @@ native_staged_apps_facts(void)
 	    native_staged_apps_stage, native_staged_apps_dirs, native_staged_apps_files, (unsigned long long)native_staged_apps_bytes,
 	    native_staged_apps_failed, native_staged_apps_error, (unsigned long long)native_staged_apps_ms, native_staged_apps_path);
 	boot_progress_trace(line);
-	snprintf(line, sizeof(line), "overlays: audio stage %d status %d", native_audio_addon_stage, native_audio_addon_status);
+	snprintf(line, sizeof(line), "overlays: audio stage %d status %d, system apps stage %d status %d", native_audio_addon_stage,
+	    native_audio_addon_status, native_system_apps_stage, native_system_apps_status);
 	boot_progress_trace(line);
 	/* What SystemAppMigrator's passes ask MobileGestalt about: SupportedDeviceFamilies follows DeviceClassNumber, the prefix of
 	 * hw.product (PEGetProductName: the root model); "arm64" (UIRequiredDeviceCapabilities) is the host's preferred user arch,
@@ -9823,6 +9829,44 @@ native_staged_apps_report(uint64_t start)
 		thread_deallocate(thread);
 	}
 }
+/* pagani-system-apps=1 (with sheng-staged-apps=1): the copied deletable system apps are shown in /Applications as built-in apps instead
+ * of being installed by the data migration. Here the migration's installs never complete (installcoordinationd moves nothing and
+ * /private/var/containers/Bundle/Application is never created, 2026-10-30/31 runs), so SystemAppMigrator demotes every app to an App
+ * Store placeholder. Their executables are in the Apple static trust cache the image carries (checked for Calendar, Mail, Notes,
+ * Reminders, Tips and Weather), so they run from any path, and lsd registers what /Applications holds when it builds its database;
+ * no copied name or bundle identifier collides with one of /Applications. The migration is switched off first: its sentinel
+ * /private/var/datamigrator/migrate (make-phone-seed.py --migrate) is removed, else SystemAppMigrator removes the copy the view shows.
+ * The view's mount arguments reuse scratch 0x800..0x91f (the addon views are done by then; launchd's environment is at 0x400..0x6ff),
+ * the unlink 0xc00 like the copy's. Stage 5 status 0: mounted with Settings and Calendar both visible in /Applications. */
+static void
+native_system_apps_show(proc_t p, user_addr_t scratch)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("pagani-system-apps", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	if (native_staged_apps_stage != 2 && native_staged_apps_stage != 3) {
+		native_system_apps_status = ENOENT;
+		return;
+	}
+	static const char sentinel[] = "/private/var/datamigrator/migrate";
+	struct unlink_args request = {.path = scratch + 0xc00};
+	int32_t result = 0;
+	int error = copyout(sentinel, request.path, sizeof(sentinel));
+	if (!error) {
+		error = unlink(p, &request, &result);
+	}
+	native_system_apps_sentinel = error;
+	static const char source[] = "/private/var/staged_system_apps", point[] = "/Applications";
+	native_gpu_addon_mount(p, scratch, 0x800, source, sizeof(source), point, sizeof(point), "/Applications/Preferences.app",
+	    "/Applications/MobileCal.app", &native_system_apps_stage, &native_system_apps_status);
+	if (boot_progress_trace) {
+		char line[96];
+		snprintf(line, sizeof(line), "system apps view stage %d status %d, migration sentinel %d", native_system_apps_stage,
+		    native_system_apps_status, native_system_apps_sentinel);
+		boot_progress_trace(line);
+	}
+}
 /* The copy above with its result in the boot log (BootProgress U lines on boards that link it): stage, directories, files, bytes,
  * failures, last error and time, then the watch on the data migration. */
 static void
@@ -9837,6 +9881,7 @@ native_staged_apps_prepare(proc_t p, user_addr_t scratch, mount_t data_mount)
 		boot_progress_trace("staged apps copy: /private/var/staged_system_apps of the OS volume into Data");
 	}
 	native_staged_apps_copy(p, scratch, data_mount);
+	native_system_apps_show(p, scratch);
 	if (boot_progress_trace) {
 		native_staged_apps_report(start);
 	}
