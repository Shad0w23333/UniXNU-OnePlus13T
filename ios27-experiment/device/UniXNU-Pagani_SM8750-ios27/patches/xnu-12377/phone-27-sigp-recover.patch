原文件的版权声明和许可条款继续有效，这里只改写说明文字和按 13T 调整的部分。

类别：板无关，SMP 防御。
作用：已启动的核如果漏了启动时的自发 IPI，SIGPdisabled 会一直挂着，之后所有发给它的 IPI 都被丢掉，
表现是随机挂起，或者空闲核 100% 忙。发信号和进 idle 时把这个标志清掉。
改动：符号改名 sheng_sigp_recover → native_sigp_recover，驱动没有引用这些符号；
去掉 sheng_idle_enter、sheng_idle_disallowed、sheng_idle_sigp_cleared/refused 计数（给 sheng 的日志线程用的）。
与 phone-stall-probe 的 extern 块相邻，按 12377 上的顺序排好。
上游记录：上游见过随机挂起和空闲核 100% 忙。13T 现在有 armcpu-self-ipi=1，未必触发，当防御带上。

diff --git a/osfmk/arm/cpu_common.c b/osfmk/arm/cpu_common.c
index 0a56fb2..6793616 100644
--- a/osfmk/arm/cpu_common.c
+++ b/osfmk/arm/cpu_common.c
@@ -409,6 +409,22 @@ cpu_immediate_xcall(int cpu_number, broadcastFunc func, void *param)
 	return cpu_xcall_internal(SIGPxcallImm, cpu_number, func, param);
 }
 
+/* sheng (UniXNU): a started core whose SIGPdisabled is still set lost the self-IPI that should have cleared it (seen as random early hangs
+ * and UFS root failures under SMP: the I/O thread's wakeup IPI to that core was silently dropped). A core in InitState|StartedState runs and
+ * takes interrupts, so the flag is cleared here and the signal sent. Counted in native_sigp_recovered. */
+volatile uint32_t native_sigp_recovered;
+bool native_sigp_recover(cpu_data_t *target_proc);
+bool
+native_sigp_recover(cpu_data_t *target_proc)
+{
+	if ((os_atomic_load(&target_proc->cpu_flags, relaxed) & (InitState | StartedState)) != (InitState | StartedState)) {
+		return false;
+	}
+	os_atomic_andnot(&target_proc->cpu_signal, SIGPdisabled, acq_rel);
+	os_atomic_inc(&native_sigp_recovered, relaxed);
+	return true;
+}
+
 #if defined(XNU_BOOT_PROGRESS) && XNU_BOOT_PROGRESS && defined(__arm64__)
 /* UniXNU stall probe (osfmk/kern/bsd_kern.c): every SGI that goes out and every signal handler that runs. */
 extern uint32_t pagani_stall_on;
@@ -445,6 +461,9 @@ cpu_signal_internal(cpu_data_t *target_proc,
 
 		do {
 			current_signals = target_proc->cpu_signal;
+			if ((current_signals & SIGPdisabled) == SIGPdisabled && native_sigp_recover(target_proc)) {
+				current_signals = target_proc->cpu_signal;
+			}
 			if ((current_signals & SIGPdisabled) == SIGPdisabled) {
 				ml_set_interrupts_enabled(interruptible);
 				return KERN_FAILURE;
@@ -488,6 +507,9 @@ cpu_signal_internal(cpu_data_t *target_proc,
 	} else {
 		do {
 			current_signals = target_proc->cpu_signal;
+			if ((current_signals & SIGPdisabled) == SIGPdisabled && current_proc != target_proc && native_sigp_recover(target_proc)) {
+				current_signals = target_proc->cpu_signal;
+			}
 			if ((current_signals & SIGPdisabled) == SIGPdisabled) {
 				if (current_proc == target_proc) {
 					panic("cpu_signal of self while signals are disabled");
