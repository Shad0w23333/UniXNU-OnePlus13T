@@ -936,6 +948,7 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 
 	if (!matching) {
 		OSString * astring;
+		boot_progress_root("root fallback", "IOMedia Content=Apple_HFS", 0);
