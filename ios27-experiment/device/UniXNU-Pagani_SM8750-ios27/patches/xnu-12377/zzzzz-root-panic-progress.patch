@@ -1341,7 +1342,9 @@ setconf(void)
 	u_int32_t       flags;
 	kern_return_t   err;
 
+	boot_progress_root("setconf enter", NULL, 0);
 	err = IOFindBSDRoot(rootdevice, sizeof(rootdevice), &rootdev, &flags);
+	boot_progress_root("setconf returned", err ? NULL : rootdevice, (uint32_t)err);
 	if (err) {
 		printf("setconf: IOFindBSDRoot returned an error (%d);"
 		    "setting rootdevice to 'sd0a'.\n", err);     /* XXX DEBUG TEMP */
