 		matching = IOService::serviceMatching( "IOMedia" );
@@ -948,14 +961,17 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	}
 
 	if (gIOKitDebug & kIOWaitQuietBeforeRoot) {
+		boot_progress_root("root waitQuiet enter", NULL, 0);
 		IOLog( "Waiting for matching to complete\n" );
 		IOService::getPlatform()->waitQuiet();
+		boot_progress_root("root waitQuiet returned", NULL, 0);
 	}
 
 	if (matching) {
 		OSSerialize * s = OSSerialize::withCapacity( 5 );
 
 		if (matching->serialize( s )) {
+			boot_progress_root("root match criteria", s->text(), ROOTDEVICETIMEOUT);
 			IOLog( "Waiting on %s\n", s->text());
 		}
 		s->release();
@@ -972,10 +988,14 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 		t.tv_sec = ROOTDEVICETIMEOUT;
 		t.tv_nsec = 0;
 		matching->retain();
+		boot_progress_root("root device wait begin", NULL, t.tv_sec);
 		service = IOService::waitForService( matching, &t );
+		boot_progress_root("root device wait returned", service ? "matched" : "timeout", 0);
 		if ((-1 != wdt) && (!service || (mountAttempts == 10))) {
 #if !XNU_TARGET_OS_OSX || !defined(__arm64__)
+			boot_progress_root("root timeout: noroot icon", NULL, ROOTDEVICETIMEOUT);
 			PE_display_icon( 0, "noroot");
+			boot_progress_root("root timeout: icon returned", NULL, 0);
 			IOLog( "Still waiting for root device\n" );
 #endif
 
