 		if ((regEntry = IORegistryEntry::fromPath( "/chosen/memory-map", gIODTPlane ))) {        /* Find the map node */
 			data = (OSData *)regEntry->getProperty("RAMDisk");      /* Find the ram disk, if there */
+			boot_progress_root("RAMDisk property", data ? "present" : "absent", 0);
 			if (data) {                                                                                      /* We found one */
 				uintptr_t *ramdParms;
 				/* BEGIN IGNORE CODESTYLE */
@@ -901,6 +912,7 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 		}
 	}
 
+	boot_progress_root("root matching selection", rdBootVar, matching != NULL);
 	if ((!matching) && rdBootVar[0]) {
 		// by BSD name
