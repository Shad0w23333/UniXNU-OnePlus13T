zzwc-native-adreno-sandbox-grant-all.patch（xnu-12377 版）

来源：本项目 UniXNU-Pagani_SM8750-gpu/patches/xnu/zzwc-native-adreno-sandbox-grant-all.patch（10063）。
处理：保留，无模糊，偏移 48 行。
作用：服务带 NativeSandboxGrantAll=true 时，所有进程都能打开它的 user client（A830 加速器）。
替代关系：sheng 的 BRINGUP 用属性值 "*" 做同样的事（IOUserClient.cpp 1 块），我方驱动用的是
NativeSandboxGrantAll，保留我方写法，不带 sheng 那块。

diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
index 0d9c70a..6379e22 100644
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -4407,6 +4407,17 @@ native_sandbox_grant(IOService * service)
 	return false;
 }
 
+/*
+ * The open path's grant: the process list above, or every process when the service carries NativeSandboxGrantAll = true (the A830
+ * driver's accelerator: every app and extension may run its Metal plugin, which decides itself which processes get a device by the
+ * seed's NativeAdrenoMetal.clients). Only opening a user client of that service is affected; setting its properties is not.
+ */
+static bool
+native_sandbox_grant_open(IOService * service)
+{
+	return native_sandbox_grant(service) || service->getProperty("NativeSandboxGrantAll") == kOSBooleanTrue;
+}
+
 kern_return_t
 is_io_service_open_extended(
 	io_object_t _service,
@@ -4435,7 +4446,7 @@ is_io_service_open_extended(
 	}
 
 #if CONFIG_MACF
-	if (!native_sandbox_grant(service) && mac_iokit_check_open_service(kauth_cred_get(), service, connect_type) != 0) {
+	if (!native_sandbox_grant_open(service) && mac_iokit_check_open_service(kauth_cred_get(), service, connect_type) != 0) {
 		return kIOReturnNotPermitted;
 	}
 #endif
@@ -4595,7 +4606,7 @@ is_io_service_open_extended(
 			}
 #if CONFIG_MACF
 			/* The service's grant (native_sandbox_grant) stands in for the sandbox's verdict on the render server's open. */
-			else if (!native_sandbox_grant(service)
+			else if (!native_sandbox_grant_open(service)
 			    && 0 != mac_iokit_check_open(kauth_cred_get(), client, connect_type)) {
 				IOLog("IOUC %s failed MACF in process %s\n",
 				    client->getMetaClass()->getClassName(), creatorNameCStr);
@@ -4604,7 +4615,7 @@ is_io_service_open_extended(
 #endif
 
 			if ((kIOReturnSuccess == res)
-			    && !native_sandbox_grant(service)
+			    && !native_sandbox_grant_open(service)
 			    && gIOUCFilterCallbacks
 			    && gIOUCFilterCallbacks->io_filter_resolver) {
 				io_filter_policy_t filterPolicy;
