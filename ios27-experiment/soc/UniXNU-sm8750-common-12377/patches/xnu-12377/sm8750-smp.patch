 	for (unsigned i = 0; i < topology_info.num_cpus; i++) {
 		if (topology_info.cpus[i].phys_id == phys_id) {
diff --git a/osfmk/arm64/machine_routines_asm.s b/osfmk/arm64/machine_routines_asm.s
index 671dc50..2c96368 100644
--- a/osfmk/arm64/machine_routines_asm.s
+++ b/osfmk/arm64/machine_routines_asm.s
@@ -1594,7 +1594,7 @@ vm_sleep_individual_cpu:
 	orr		x9, x9, x10
 	msr		CPU_OVRD, x9
 	isb
-#else
+#elif defined(APPLE_ARM64_ARCH_FAMILY) /* SM8750：ACNTHV_CTL_EL2 是苹果实现定义寄存器，Oryon 在 EL1 访问不了 */
 	// Mask timer IRQs before entering WFI
 	mrs     x9, ACNTHV_CTL_EL2
 	mov     x10, #(~ACNTHV_CTL_EL2_EN_MASK)
@@ -1664,7 +1664,7 @@ Lwfi_inst:
 	dsb		sy
 	isb		sy
 	wfi
-#if NO_CPU_OVRD
+#if NO_CPU_OVRD && defined(APPLE_ARM64_ARCH_FAMILY) /* SM8750：S3_5_C15_C1_1 是苹果的 IPI 状态寄存器 */
 	// Clear any spurious IPIs received during CPU shutdown
 	mov     x9, #0x1
 	msr     S3_5_C15_C1_1, x9
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index d66c616..a0a7ca0 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -146,7 +146,7 @@ LEXT(reset_vector)
 	add		x19, x19, EXT(ResetHandlerData)@pageoff
 	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
 #if HAS_CLUSTER
-	and		x0, x15, #0xFFFF					// CPU number in Affinity0, cluster ID in Affinity1
+	and		x0, x15, #0xFFFFFF				// SM8750: core in Aff1, cluster in Aff2
 #else
 	and		x0, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0
 #endif
